(function () {
  const modalEl = document.getElementById('stockModal');
  const formEl = document.getElementById('shipOrderForm');
  const container = document.getElementById('ship-serials-container');
  const wrapper = document.getElementById('ship-serials-wrapper');
  const errBox = document.getElementById('ship-serials-error');
  const searchEl = document.getElementById('serialSearch');

  function hardFail(msg, extra) {
    console.error(msg, extra || '');
    // hiện bằng alert để khỏi “im lặng”
    alert(msg);
  }

  if (!modalEl || !formEl || !container || !wrapper) {
    hardFail('ShipSerials: Thiếu DOM trong modal xuất kho. Kiểm tra ID: stockModal, shipOrderForm, ship-serials-container, ship-serials-wrapper', {
      modalEl, formEl, container, wrapper
    });
    return;
  }

  let loadedData = null;

  function showError(msg) {
    if (errBox) {
      errBox.style.display = 'block';
      errBox.innerHTML = msg;
    } else {
      hardFail('ShipSerials error: ' + msg);
    }
  }
  function hideError() {
    if (!errBox) return;
    errBox.style.display = 'none';
    errBox.innerHTML = '';
  }

  function escapeHtml(str) {
    return String(str || '').replace(/[&<>"']/g, s => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
    }[s]));
  }

  function updateSelectedCounts() {
    hideError();
    const counts = {};
    container.querySelectorAll('.serial-checkbox:checked').forEach(cb => {
      const itemId = cb.dataset.itemId;
      counts[itemId] = (counts[itemId] || 0) + 1;
    });

    container.querySelectorAll('.serial-selected-count').forEach(span => {
      const itemId = span.dataset.itemId;
      span.textContent = String(counts[itemId] || 0);
    });
  }

  function renderItems(items) {
    container.innerHTML = '';

   if (!items || items.length === 0) {
  wrapper.style.display = 'block';
  container.innerHTML = `
    <div class="alert alert-info mb-0">
      Đơn này không có sản phẩm cần chọn Serial/IMEI.
    </div>`;
  return;
}

    wrapper.style.display = 'block';

    items.forEach(item => {
      const sku = (item.sku && String(item.sku).trim() !== '') ? ` (${item.sku})` : '';
      const title = `${item.product_name}${sku} - SL: ${item.qty}`;
      const itemId = item.item_id;
      const serials = Array.isArray(item.serials) ? item.serials : [];

      const block = document.createElement('div');
      block.className = 'border rounded p-2 mb-3';

      block.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="fw-semibold">${escapeHtml(title)}</div>
          <div class="small text-muted">Có sẵn: <span>${serials.length}</span></div>
        </div>

        <div class="small mb-2">
          Đã chọn: <span class="serial-selected-count text-primary fw-semibold" data-item-id="${itemId}">0</span> / ${item.qty}
          <button type="button" class="btn btn-sm btn-outline-secondary ms-2" data-action="clear" data-item-id="${itemId}">Bỏ chọn</button>
          <button type="button" class="btn btn-sm btn-outline-primary ms-1" data-action="auto" data-item-id="${itemId}">Chọn đủ (${item.qty})</button>
        </div>

        <div class="serial-list row g-2" data-item-id="${itemId}">
          ${serials.map(code => `
            <div class="col-6 col-md-4">
              <label class="d-flex align-items-center gap-2 border rounded px-2 py-1 w-100">
                <input type="checkbox" class="serial-checkbox"
                       name="serials[${itemId}][]"
                       value="${escapeHtml(code)}"
                       data-item-id="${itemId}">
                <span class="font-monospace">${escapeHtml(code)}</span>
              </label>
            </div>
          `).join('')}
        </div>
      `;

      container.appendChild(block);
    });

    container.querySelectorAll('button[data-action="clear"]').forEach(btn => {
      btn.addEventListener('click', () => {
        const itemId = btn.dataset.itemId;
        container.querySelectorAll(`.serial-checkbox[data-item-id="${itemId}"]`).forEach(cb => cb.checked = false);
        updateSelectedCounts();
      });
    });

    container.querySelectorAll('button[data-action="auto"]').forEach(btn => {
      btn.addEventListener('click', () => {
        const itemId = btn.dataset.itemId;
        const item = (loadedData?.items || []).find(x => String(x.item_id) === String(itemId));
        const need = parseInt(item?.qty || 0, 10);

        const cbs = Array.from(container.querySelectorAll(`.serial-checkbox[data-item-id="${itemId}"]`));
        cbs.forEach(cb => cb.checked = false);
        cbs.slice(0, need).forEach(cb => cb.checked = true);
        updateSelectedCounts();
      });
    });

    container.querySelectorAll('.serial-checkbox').forEach(cb => {
      cb.addEventListener('change', updateSelectedCounts);
    });

    updateSelectedCounts();
  }

  function applySearchFilter() {
    const q = (searchEl?.value || '').trim().toUpperCase();
    container.querySelectorAll('.serial-list > div').forEach(el => {
      const text = el.textContent.toUpperCase();
      el.style.display = q === '' || text.includes(q) ? '' : 'none';
    });
  }

  async function loadSerials() {
    loadedData = null;
    hideError();

    if (!window.SHIP_SERIALS_URL) {
      showError('Thiếu biến window.SHIP_SERIALS_URL trong Blade.');
      return;
    }

    container.innerHTML = '<div class="text-muted">Đang tải serial...</div>';
    wrapper.style.display = 'block';

    try {
      const res = await fetch(window.SHIP_SERIALS_URL, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });

      const text = await res.text(); // đọc raw để debug
      let data = null;
      try { data = JSON.parse(text); } catch (_) {}

      if (!res.ok) {
        console.error('ShipSerials API error:', res.status, text);
        showError(`API ship-serials lỗi <b>${res.status}</b>: ${escapeHtml(text)}`);
        return;
      }

      loadedData = data || {};
      renderItems(loadedData.items || []);
    } catch (e) {
      console.error(e);
      showError('Không gọi được API ship-serials (network/server).');
    }
  }

  formEl.addEventListener('submit', function (e) {
    hideError();
    if (!loadedData || !Array.isArray(loadedData.items) || loadedData.items.length === 0) return;

    const bad = [];
    loadedData.items.forEach(item => {
      const itemId = String(item.item_id);
      const required = parseInt(item.qty || 0, 10);
      const selected = container.querySelectorAll(`.serial-checkbox[data-item-id="${itemId}"]:checked`).length;

      if (required > 0 && selected !== required) {
        bad.push(`${item.product_name} cần ${required} serial, bạn đang chọn ${selected}`);
      }
    });

    if (bad.length > 0) {
      e.preventDefault();
      showError('<strong>Chưa chọn đủ serial:</strong><br>' + bad.map(x => `• ${escapeHtml(x)}`).join('<br>'));
    }
  });

  modalEl.addEventListener('shown.bs.modal', loadSerials);
  if (searchEl) searchEl.addEventListener('input', applySearchFilter);
})();
