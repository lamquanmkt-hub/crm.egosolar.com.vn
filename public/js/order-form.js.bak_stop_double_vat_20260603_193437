class OrderFormManager {
  constructor() {
    this.rowIndex = window.rowIndex ?? 1;
    this.customerTypeId = window.customerTypeId ?? null;
    this.productsByWarehouse = {};

    this.initializeElements();
    this.attachEventListeners();

    this.bootstrap().catch(console.error);

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.ts-wrapper') && !e.target.closest('.ts-dropdown')) {
        this.blurAllTomSelects();
      }
    });
  }

  initializeElements() {
    this.elements = {
      customerSelect: document.getElementById('customerSelect'),
      leadIdInput: document.getElementById('leadIdInput'),
      customerInfo: document.getElementById('customerInfo'),

      priceTierSelect: document.getElementById('price_tier_id'),

      productTableBody: document.getElementById('productTableBody'),
      addProductBtn: document.getElementById('addProductBtn'),

      totalItems: document.getElementById('totalItems'),
      totalQuantity: document.getElementById('totalQuantity'),
      totalAmount: document.getElementById('totalAmount'),
      grandTotal: document.getElementById('grandTotal'),
      invoiceItems: document.getElementById('invoiceItems'),
    };
  }

  attachEventListeners() {
    if (this.elements.customerSelect) {
      this.elements.customerSelect.addEventListener('change', () => this.handleCustomerChange());
    }

    if (this.elements.addProductBtn) {
      this.elements.addProductBtn.addEventListener('click', () => this.addProductRow());
    }

    if (this.elements.priceTierSelect) {
      this.elements.priceTierSelect.addEventListener('change', async () => {
        await this.updateAllProductPrices();
      });
    }

    this.elements.productTableBody?.querySelectorAll('.product-row').forEach(row => {
      this.attachRowEvents(row);
    });
  }

  async bootstrap() {
    const rows = this.elements.productTableBody?.querySelectorAll('.product-row') || [];

    for (const row of rows) {
      this.initTomSelectForRow(row);

      const whSelect = row.querySelector('.warehouse-select');
      const productSelect = row.querySelector('.product-select');
      const whId = whSelect?.value || '';
      const productId = this.getProductSelectValue(productSelect) || '';

      this.toggleUnitPriceEditable(row);

      if (whId) {
        const products = await this.getProductsByWarehouseCached(whId, true);
        this.setRowProducts(row, products);

        if (productId) {
          const selected = products.find(p => String(p.id) === String(productId));
          if (selected) {
            this.setSelectedProduct(row, selected, false);
          }
        }

        this.updatePriceTierOptions(row);
        if (productId) {
          this.updateProductPrice(row);
        }
      }

      this.calculateLineTotal(row);
    }

    if (this.elements.customerSelect?.value) {
      await this.handleCustomerChange().catch(console.error);
    } else {
      this.updateTotals();
    }
  }

  initTomSelectForRow(row) {
    const productSelect = row.querySelector('.product-select');
    if (!productSelect || typeof TomSelect === 'undefined') return;
    if (productSelect.tomselect) return;

    const self = this;

    new TomSelect(productSelect, {
      create: false,
      maxOptions: 5000,
      closeAfterSelect: true,
      allowEmptyOption: true,
      placeholder: productSelect.dataset.placeholder || '-- Chọn sản phẩm --',
      searchField: ['text'],
      valueField: 'value',
      labelField: 'text',
      searchConjunction: 'and',
      dropdownParent: 'body',
      openOnFocus: true,
      preload: false,
      render: {
        option: function(data, escape) {
          return '<div>' + escape(data.text) + '</div>';
        },
        item: function(data, escape) {
          return '<div>' + escape(data.text) + '</div>';
        }
      },
      onInitialize: function() {
        this.wrapper.style.width = '100%';
      },
      onType: function() {
        this.refreshOptions(true);
      },
      onDropdownOpen: function() {
        this.refreshOptions(true);
      },
      onChange: function(value) {
        const products = self.getRowProducts(row);
        const selected = products.find(p => String(p.id) === String(value));

        const meta = row.querySelector('.product-selected-meta');
        if (meta && selected) {
          meta.dataset.priceRetail = String(selected.price_retail || 0);
          meta.dataset.priceAgent = String(selected.price_agent || 0);
          meta.dataset.tierPrices = JSON.stringify(selected.tier_prices || {});
          meta.dataset.vatPercent = String(selected.vat_percent || 0);
          meta.dataset.tierVats = JSON.stringify(selected.tier_vats || {});
        }

        self.updatePriceTierOptions(row);
        self.updateProductPrice(row);
        self.calculateLineTotal(row);
      }
    });
  }

  blurAllTomSelects() {
    document.querySelectorAll('.product-select').forEach(el => {
      if (el.tomselect) {
        el.tomselect.blur();
      }
    });
  }

  getProductSelectValue(productSelect) {
    if (!productSelect) return '';
    if (productSelect.tomselect) return productSelect.tomselect.getValue() || '';
    return productSelect.value || '';
  }

  setProductSelectValue(productSelect, value, silent = false) {
    if (!productSelect) return;
    if (productSelect.tomselect) {
      productSelect.tomselect.setValue(String(value || ''), silent);
      return;
    }
    productSelect.value = value || '';
  }

  async getProductsByWarehouseCached(warehouseId, forceReload = false) {
    if (!warehouseId) return [];
    if (!forceReload && this.productsByWarehouse[warehouseId]) {
      return this.productsByWarehouse[warehouseId];
    }

    const res = await fetch(`/orders/products-by-warehouse?warehouse_id=${warehouseId}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });

    if (!res.ok) throw new Error('Failed to load products');

    const data = await res.json();
    this.productsByWarehouse[warehouseId] = data.products || [];
    return this.productsByWarehouse[warehouseId];
  }

  normalizeProduct(product) {
    return {
      id: String(product.id),
      name: product.name || '',
      sku: product.sku || '',
      display: product.display || `${product.name || ''}${product.sku ? ` (${product.sku})` : ''}`,
      price_retail: Number(product.price_retail ?? 0),
      price_agent: Number(product.price_agent ?? 0),
      vat_percent: Number(product.vat_percent ?? 0),
      vat_percent: Number(product.vat_percent ?? 0),
      tier_prices: product.tier_prices || {},
      tier_vats: product.tier_vats || {},
      stock: product.stock ?? product.quantity ?? ''
    };
  }

  setRowProducts(row, products) {
    const normalized = (products || []).map(p => this.normalizeProduct(p));
    row._products = normalized;

    const productSelect = row.querySelector('.product-select');
    if (!productSelect) return;

    const currentValue = this.getProductSelectValue(productSelect);

    if (productSelect.tomselect) {
      const ts = productSelect.tomselect;
      ts.clear(true);
      ts.clearOptions();

      ts.addOption({
        value: '',
        text: '-- Chọn sản phẩm --',
        price_retail: 0,
        price_agent: 0,
        tier_prices: {}
      });

      normalized.forEach(p => {
        ts.addOption({
          value: String(p.id),
          text: p.display || p.name,
          price_retail: p.price_retail || 0,
          price_agent: p.price_agent || 0,
          vat_percent: p.vat_percent || 0,
          tier_prices: p.tier_prices,
          tier_vats: p.tier_vats || {} || {}
        });
      });

      ts.refreshOptions(false);

      if (currentValue && normalized.some(p => String(p.id) === String(currentValue))) {
        ts.setValue(String(currentValue), true);
      }
      return;
    }

    let html = '<option value="">-- Chọn sản phẩm --</option>';
    normalized.forEach(p => {
      html += `
        <option
          value="${this.escapeHtml(p.id)}"
          data-price-retail="${p.price_retail || 0}"
          data-price-agent="${p.price_agent || 0}"
          data-tier-prices='${this.escapeHtml(JSON.stringify(p.tier_prices || {}))}'
        >
          ${this.escapeHtml(p.display || p.name)}
        </option>
      `;
    });

    productSelect.innerHTML = html;

    if (currentValue && normalized.some(p => String(p.id) === String(currentValue))) {
      productSelect.value = currentValue;
    }
  }

  getRowProducts(row) {
    return Array.isArray(row._products) ? row._products : [];
  }

  clearSelectedProduct(row) {
    const productIdInput = row.querySelector('.product-id');
    const meta = row.querySelector('.product-selected-meta');
    const productSelect = row.querySelector('.product-select');

    if (productIdInput) productIdInput.value = '';
    if (meta) {
      meta.dataset.priceRetail = '';
      meta.dataset.priceAgent = '';
      meta.dataset.tierPrices = '{}';
    }

    this.setProductSelectValue(productSelect, '', true);

    const priceInput = row.querySelector('.unit-price');
    if (priceInput && !this.isInternalPriceTier(row)) {
      priceInput.value = '';
    }

    this.updatePriceTierOptions(row);
    this.calculateLineTotal(row);
  }

  setSelectedProduct(row, product, recalc = true) {
    const p = this.normalizeProduct(product);

    const productIdInput = row.querySelector('.product-id');
    const meta = row.querySelector('.product-selected-meta');
    const productSelect = row.querySelector('.product-select');

    if (productIdInput) productIdInput.value = p.id;
    if (meta) {
      meta.dataset.priceRetail = String(p.price_retail || 0);
      meta.dataset.priceAgent = String(p.price_agent || 0);
      meta.dataset.vatPercent = String(p.vat_percent || 0);
      meta.dataset.tierPrices = JSON.stringify(p.tier_prices || {});
      meta.dataset.tierVats = JSON.stringify(p.tier_vats || {});
    }

    this.setProductSelectValue(productSelect, p.id, true);
    this.updatePriceTierOptions(row);

    if (this.isInternalPriceTier(row)) {
      const priceInput = row.querySelector('.unit-price');
      if (priceInput) priceInput.value = '';
    } else {
      this.updateProductPrice(row);
    }

    if (recalc) {
      this.calculateLineTotal(row);
    }
  }

  attachRowEvents(row) {
    const whSelect = row.querySelector('.warehouse-select');
    const quantityInput = row.querySelector('.quantity');
    const unitPriceInput = row.querySelector('.unit-price');
    const discountPercentInput = row.querySelector('.discount-percent');
    const discountPerUnitInput = row.querySelector('.discount-per-unit');
    const removeBtn = row.querySelector('.remove-product-btn');
    const tierSelect = row.querySelector('.price-tier-select');

    this.initTomSelectForRow(row);

    if (whSelect) {
      whSelect.addEventListener('change', async () => {
        this.clearSelectedProduct(row);
        this.setRowProducts(row, []);

        const unitPriceEl = row.querySelector('.unit-price');
        const lineTotalEl = row.querySelector('.line-total');

        if (unitPriceEl) {
          if (!this.isInternalPriceTier(row)) unitPriceEl.value = '';
          unitPriceEl.setAttribute('readonly', 'readonly');
          delete unitPriceEl.dataset.manualUnlocked;
        }

        if (lineTotalEl) lineTotalEl.value = '';
        if (discountPercentInput) discountPercentInput.value = '0';
        if (discountPerUnitInput) discountPerUnitInput.value = '0';

        const whId = whSelect.value;
        if (!whId) {
          this.updateTotals();
          return;
        }

        try {
          const products = await this.getProductsByWarehouseCached(whId, true);
          this.setRowProducts(row, products);

          const productSelect = row.querySelector('.product-select');
          if (productSelect?.tomselect) {
            productSelect.tomselect.clear(true);
            productSelect.tomselect.refreshOptions(false);
          }
        } catch (e) {
          console.error(e);
          alert('Không tải được danh sách sản phẩm theo kho');
        }

        this.toggleUnitPriceEditable(row);
        this.updateTotals();
      });
    }

    if (tierSelect) {
      tierSelect.addEventListener('change', () => {
        const priceInput = row.querySelector('.unit-price');
        const isInternal = this.isInternalPriceTier(row);

        this.toggleUnitPriceEditable(row);

        if (isInternal) {
          if (priceInput) {
            priceInput.value = '';
            priceInput.focus();
          }
        } else {
          this.updateProductPrice(row);
        }

        this.calculateLineTotal(row);
      });
    }

    if (quantityInput) {
      quantityInput.addEventListener('input', () => this.calculateLineTotal(row));
    }

    if (unitPriceInput) {
      unitPriceInput.addEventListener('input', () => this.calculateLineTotal(row));
      unitPriceInput.addEventListener('change', () => this.calculateLineTotal(row));
    }

    if (discountPercentInput) {
      discountPercentInput.addEventListener('input', () => {
        if (discountPerUnitInput) discountPerUnitInput.value = '0';
        this.calculateLineTotal(row);
      });
    }

    if (discountPerUnitInput) {
      discountPerUnitInput.addEventListener('input', () => {
        if (discountPercentInput) discountPercentInput.value = '0';
        this.calculateLineTotal(row);
      });

      discountPerUnitInput.addEventListener('change', () => {
        if (discountPercentInput) discountPercentInput.value = '0';
        this.calculateLineTotal(row);
      });
    }

    if (removeBtn) {
      removeBtn.addEventListener('click', () => this.removeProductRow(row));
    }

    this.toggleUnitPriceEditable(row);
  }

  isInternalPriceTier(row) {
    const tierSelect = row.querySelector('.price-tier-select');
    if (!tierSelect) return false;

    const selectedOpt = tierSelect.selectedOptions?.[0];
    const code = selectedOpt?.dataset?.tierCode || '';
    const selectedText = selectedOpt?.textContent?.trim().toLowerCase() || '';
    return code === 'internal' || selectedText.includes('giá nội bộ') || selectedText.includes('nội bộ');
  }

  updatePriceTierOptions(row) {
    const tierSelect = row.querySelector('.price-tier-select');
    const productSelect = row.querySelector('.product-select');
    if (!tierSelect || !productSelect || !window.allPriceTiers?.length) return;

    const currentTierId = tierSelect.value || '';

    let selectedOpt = null;
    if (productSelect.tomselect) {
      const selectedValue = productSelect.tomselect.getValue();
      selectedOpt = productSelect.tomselect.options[selectedValue] || null;
    } else {
      selectedOpt = productSelect.selectedOptions?.[0] || null;
    }

    let tierPrices = {};
    try {
      tierPrices = productSelect.tomselect
        ? (selectedOpt?.tier_prices || {})
        : JSON.parse(selectedOpt?.dataset?.tierPrices || '{}');
    } catch (e) {
      tierPrices = {};
    }

    tierSelect.innerHTML = '<option value="">-- Theo loại giá đơn --</option>';

    window.allPriceTiers.forEach(tier => {
      const price = tierPrices[tier.id];
      const hasPrice = price !== undefined && Number(price) > 0;
      const isInternal = tier.code === 'internal' || String(tier.name || '').toLowerCase().includes('nội bộ');

      if (hasPrice || isInternal) {
        const opt = document.createElement('option');
        opt.value = String(tier.id);
        opt.textContent = tier.name;
        opt.dataset.tierCode = tier.code || '';

        if (hasPrice) {
          opt.dataset.tierPrice = String(price);
        }

        if (String(tier.id) === String(currentTierId)) {
          opt.selected = true;
        }

        tierSelect.appendChild(opt);
      }
    });

    if (currentTierId && tierSelect.value !== String(currentTierId)) {
      tierSelect.value = '';
    }
  }

  toggleUnitPriceEditable(row) {
    const priceInput = row.querySelector('.unit-price');
    if (!priceInput) return;

    const isInternal = this.isInternalPriceTier(row);

    if (isInternal) {
      priceInput.removeAttribute('readonly');
      priceInput.classList.add('is-editable');

      if (!priceInput.dataset.manualUnlocked) {
        priceInput.value = '';
        priceInput.dataset.manualUnlocked = '1';
      }
    } else {
      priceInput.setAttribute('readonly', 'readonly');
      priceInput.classList.remove('is-editable');
      delete priceInput.dataset.manualUnlocked;
    }
  }

  setRowVatPercent(row, productData = null) {
    const vatInput = row.querySelector('.item-vat-percent');
    const productSelect = row.querySelector('.product-select');
    const tierSelect = row.querySelector('.price-tier-select');

    let selectedOpt = null;
    let vat = 0;
    let tierVats = {};

    if (productData) {
      vat = Number(productData.vat_percent || 0);
      tierVats = productData.tier_vats || {};
    } else if (productSelect?.tomselect) {
      const productId = productSelect.tomselect.getValue() || '';
      selectedOpt = productSelect.tomselect.options[productId] || null;
      vat = Number(selectedOpt?.vat_percent || selectedOpt?.vatPercent || 0);
      tierVats = selectedOpt?.tier_vats || selectedOpt?.tierVats || {};
    } else {
      selectedOpt = productSelect?.selectedOptions?.[0] || null;
      vat = Number(selectedOpt?.dataset?.vatPercent || 0);
      try {
        tierVats = JSON.parse(selectedOpt?.dataset?.tierVats || '{}');
      } catch (e) {
        tierVats = {};
      }
    }

    const tierId = tierSelect?.value || '';
    if (tierId && tierVats && tierVats[tierId] !== undefined) {
      vat = Number(tierVats[tierId] || vat || 0);
    }

    if (!Number.isFinite(vat) || vat < 0) vat = 0;
    if (vat > 100) vat = 100;

    if (vatInput) vatInput.value = String(vat);
    return vat;
  }


  egoNormalizePriceAfterVat(row, price) {
    const vatInput = row.querySelector('.item-vat-percent');
    const vat = Number(vatInput?.value || 0);
    let p = Number(price || 0);

    if (!Number.isFinite(p) || p <= 0) return 0;

    /*
     * EGO FIX:
     * Bảng crm_order_items.unit_price đang được màn show hiểu là giá SAU VAT.
     * Nhưng form tạo đơn đang lấy giá TRƯỚC VAT từ bảng giá đại lý.
     * Vì vậy cần nhân VAT trước khi lưu vào input đơn giá.
     */
    if (vat > 0) {
      p = Math.round(p * (1 + vat / 100));
    }

    return p;
  }


  updateProductPrice(row) {
    const productSelect = row.querySelector('.product-select');
    const priceInput = row.querySelector('.unit-price');

    if (!productSelect || !priceInput) return;

    let selectedOpt = null;
    let productId = '';

    if (productSelect.tomselect) {
      productId = productSelect.tomselect.getValue() || '';
      selectedOpt = productSelect.tomselect.options[productId] || null;
    } else {
      selectedOpt = productSelect.selectedOptions?.[0] || null;
      productId = selectedOpt?.value || '';
    }

    const isInternal = this.isInternalPriceTier(row);
    this.toggleUnitPriceEditable(row);

    if (!productId) {
      if (!isInternal) priceInput.value = '';
      return;
    }

    if (isInternal) return;

    let retail = 0;
    let agent = 0;
    let tierPrices = {};

    if (productSelect.tomselect) {
      retail = Number(selectedOpt?.price_retail || 0);
      agent = Number(selectedOpt?.price_agent || 0);
      tierPrices = selectedOpt?.tier_prices || {};
    } else {
      retail = Number(selectedOpt?.dataset?.priceRetail || 0);
      agent = Number(selectedOpt?.dataset?.priceAgent || 0);
      try {
        tierPrices = JSON.parse(selectedOpt?.dataset?.tierPrices || '{}');
      } catch (e) {
        tierPrices = {};
      }
    }

    const tierSelect = row.querySelector('.price-tier-select');
    const selectedTierId = tierSelect?.value || '';
    const selectedTierText = tierSelect?.selectedOptions?.[0]?.textContent?.trim().toLowerCase() || '';

    let price = 0;

    this.setRowVatPercent(row);

    if (selectedTierId && tierPrices[selectedTierId]) {
      price = Number(tierPrices[selectedTierId] || 0);
    } else if (selectedTierText.includes('đại lý')) {
      price = agent || retail || 0;
    } else {
      price = retail || agent || 0;
    }

    priceInput.value = String(Math.round(this.egoNormalizePriceAfterVat(row, price)));
  }

  parseNumber(value) {
    if (value === null || value === undefined) return 0;

    let s = String(value).trim();
    if (!s) return 0;

    s = s.replace(/\s/g, '').replace(/đ/gi, '');

    if (/^\d{1,3}(\.\d{3})+$/.test(s)) {
      s = s.replace(/\./g, '');
      return parseFloat(s) || 0;
    }

    if (/^\d{1,3}(,\d{3})+$/.test(s)) {
      s = s.replace(/,/g, '');
      return parseFloat(s) || 0;
    }

    if (s.includes('.') && s.includes(',')) {
      s = s.replace(/\./g, '').replace(',', '.');
      return parseFloat(s) || 0;
    }

    if (s.includes(',') && !s.includes('.')) {
      s = s.replace(',', '.');
      return parseFloat(s) || 0;
    }

    return parseFloat(s) || 0;
  }

  clampMoney(value) {
    const n = this.parseNumber(value);
    if (isNaN(n) || n < 0) return 0;
    return n;
  }

  clampPercent(value) {
    const n = parseFloat(value);
    if (isNaN(n)) return 0;
    return Math.max(0, Math.min(100, n));
  }

  calculateLineTotal(row) {
    const price = this.parseNumber(row.querySelector('.unit-price')?.value) || 0;
    const quantity = parseInt(row.querySelector('.quantity')?.value, 10) || 0;

    const subtotal = price * quantity;

    const discountPercentEl = row.querySelector('.discount-percent');
    const discountPercent = discountPercentEl ? this.clampPercent(discountPercentEl.value) : 0;
    if (discountPercentEl) discountPercentEl.value = discountPercent;

    const discountPerUnitEl = row.querySelector('.discount-per-unit');
    const discountPerUnit = discountPerUnitEl ? this.clampMoney(discountPerUnitEl.value) : 0;
    if (discountPerUnitEl) discountPerUnitEl.value = String(discountPerUnit);

    let discount = 0;
    if (discountPerUnit > 0) {
      discount = discountPerUnit * quantity;
    } else if (discountPercent > 0) {
      discount = subtotal * discountPercent / 100;
    }

    if (discount > subtotal) discount = subtotal;

    const lineTotal = subtotal - discount;

    const lineTotalEl = row.querySelector('.line-total');
    if (lineTotalEl) lineTotalEl.value = this.formatCurrency(lineTotal);

    this.updateTotals();
  }

  async updateAllProductPrices() {
    const rows = this.elements.productTableBody?.querySelectorAll('.product-row') || [];
    for (const row of rows) {
      const productSelect = row.querySelector('.product-select');
      const productId = this.getProductSelectValue(productSelect);

      if (productId) {
        this.updateProductPrice(row);
        this.calculateLineTotal(row);
      } else {
        this.toggleUnitPriceEditable(row);
      }
    }
  }

  updateTotals() {
    const rows = this.elements.productTableBody?.querySelectorAll('.product-row') || [];

    let totalItems = 0;
    let totalQuantity = 0;
    let grandTotal = 0;

    rows.forEach(row => {
      const wh = row.querySelector('.warehouse-select')?.value;
      const productSelect = row.querySelector('.product-select');
      const productId = this.getProductSelectValue(productSelect);

      if (wh && productId) {
        totalItems++;

        const qty = parseInt(row.querySelector('.quantity')?.value, 10) || 0;
        const lineTotal = this.parseNumber(row.querySelector('.line-total')?.value) || 0;

        totalQuantity += qty;
        grandTotal += lineTotal;
      }
    });

    if (this.elements.totalItems) this.elements.totalItems.textContent = String(totalItems);
    if (this.elements.totalQuantity) this.elements.totalQuantity.textContent = String(totalQuantity);
    if (this.elements.totalAmount) this.elements.totalAmount.textContent = this.formatCurrency(grandTotal);
    if (this.elements.grandTotal) this.elements.grandTotal.textContent = this.formatCurrency(grandTotal);
  }

  addProductRow() {
    const tbody = this.elements.productTableBody;
    if (!tbody) return;

    const firstRow = tbody.querySelector('.product-row');
    if (!firstRow) return;

    const newRow = firstRow.cloneNode(true);
    const newIndex = this.rowIndex++;

    newRow.dataset.index = String(newIndex);

    // cloneNode(true) also clones TomSelect generated DOM (.ts-wrapper),
    // which breaks interactions on the new row. Remove stale wrappers first.
    newRow.querySelectorAll('.ts-wrapper').forEach(wrapper => wrapper.remove());

    newRow.querySelectorAll('input, select, textarea').forEach(el => {
      const name = el.getAttribute('name');
      if (name) {
        el.setAttribute('name', name.replace(/items\[\d+\]/g, `items[${newIndex}]`));
      }

      if (el.classList.contains('warehouse-select')) {
        el.value = '';
      } else if (el.classList.contains('product-select')) {
        if (el.tomselect) el.tomselect.destroy();
        el.classList.remove('tomselected', 'ts-hidden-accessible');
        el.removeAttribute('tabindex');
        el.removeAttribute('hidden');
        el.style.removeProperty('display');
        el.innerHTML = '<option value="">-- Chọn sản phẩm --</option>';
        el.value = '';
      } else if (el.classList.contains('price-tier-select')) {
        el.value = '';
      } else if (el.classList.contains('unit-price')) {
        el.value = '';
      } else if (el.classList.contains('discount-percent')) {
        el.value = '0';
      } else if (el.classList.contains('discount-per-unit')) {
        el.value = '0';
      } else if (el.classList.contains('quantity')) {
        el.value = '1';
      } else if (el.classList.contains('item-vat-percent')) {
        el.value = '0';
      } else if (el.classList.contains('line-total')) {
        el.value = '';
      } else if (el.type !== 'hidden') {
        el.value = '';
      }
    });

    newRow.querySelectorAll('input[type="hidden"]').forEach(hidden => {
      if (/\[id\]$/.test(hidden.name)) hidden.remove();
    });

    newRow._products = [];
    tbody.appendChild(newRow);

    this.attachRowEvents(newRow);
    this.initTomSelectForRow(newRow);
    this.updateTotals();
  }

  removeProductRow(row) {
    const tbody = this.elements.productTableBody;
    if (!tbody) return;

    const rows = tbody.querySelectorAll('.product-row');
    if (rows.length <= 1) {
      this.clearRow(row);
      this.updateTotals();
      return;
    }

    const select = row.querySelector('.product-select');
    if (select?.tomselect) {
      select.tomselect.destroy();
    }

    row.remove();
    this.refreshRowIndexes();
    this.updateTotals();
  }

  clearRow(row) {
    row.querySelectorAll('input, select, textarea').forEach(el => {
      if (el.classList.contains('warehouse-select')) {
        el.value = '';
      } else if (el.classList.contains('product-select')) {
        if (el.tomselect) {
          el.tomselect.clear(true);
          el.tomselect.clearOptions();
          el.tomselect.addOption({ value: '', text: '-- Chọn sản phẩm --' });
          el.tomselect.refreshOptions(false);
        } else {
          el.innerHTML = '<option value="">-- Chọn sản phẩm --</option>';
          el.value = '';
        }
      } else if (el.classList.contains('price-tier-select')) {
        el.value = '';
      } else if (el.classList.contains('unit-price')) {
        el.value = '';
      } else if (el.classList.contains('discount-percent')) {
        el.value = '0';
      } else if (el.classList.contains('discount-per-unit')) {
        el.value = '0';
      } else if (el.classList.contains('quantity')) {
        el.value = '1';
      } else if (el.classList.contains('item-vat-percent')) {
        el.value = '0';
      } else if (el.classList.contains('line-total')) {
        el.value = '';
      }
    });

    row._products = [];
  }

  refreshRowIndexes() {
    const rows = this.elements.productTableBody?.querySelectorAll('.product-row') || [];
    rows.forEach((row, index) => {
      row.dataset.index = String(index);
      row.querySelectorAll('input, select, textarea').forEach(el => {
        const name = el.getAttribute('name');
        if (name) {
          el.setAttribute('name', name.replace(/items\[\d+\]/g, `items[${index}]`));
        }
      });
    });
    this.rowIndex = rows.length;
  }

  async handleCustomerChange() {
    const customerId = this.elements.customerSelect?.value;
    if (!customerId) return;

    try {
      const res = await fetch(`/orders/customer-info/${customerId}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });

      if (!res.ok) return;

      const data = await res.json();
      if (this.elements.leadIdInput && data.customer?.lead_id) {
        this.elements.leadIdInput.value = data.customer.lead_id;
      }
    } catch (e) {
      console.error(e);
    }
  }

  formatCurrency(value) {
    const n = Number(value || 0);
    return new Intl.NumberFormat('vi-VN').format(n) + ' đ';
  }

  escapeHtml(str) {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }
}

document.addEventListener('DOMContentLoaded', () => {
  try {
    window.orderFormManager = new OrderFormManager();
  } catch (e) {
    console.error('OrderFormManager init failed:', e);
  }
});