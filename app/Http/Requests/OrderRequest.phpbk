<?php
namespace App\Http\Requests;
use App\Models\Product;
use App\Services\ProductStockService;
use Illuminate\Foundation\Http\FormRequest;
class OrderRequest extends FormRequest
{
	public function authorize(): bool
	{
		return true;
	}
	public function rules(): array
	{
		$rules = [
			'lead_id' => 'required|exists:crm_leads,id',
			'order_date' => 'required|date',
			'warehouse_id' => 'required|exists:crm_warehouses,id',
			'items' => 'required|array|min:1',
			'items.*.product_id' => 'required|exists:crm_product_catalog,id',
			'items.*.quantity' => 'required|integer|min:1',
			'items.*.unit_price' => 'required|numeric|min:0',
		];
		// Khi update, một số trường có thể optional
		if ($this->isMethod('PUT') || $this->isMethod('PATCH')) {
			$rules['lead_id'] = 'sometimes|required|exists:crm_leads,id';
			$rules['items'] = 'sometimes|required|array|min:1';
		}
		return $rules;
	}
	public function messages(): array
	{
		return [
			'lead_id.required' => 'Vui lòng chọn khách hàng',
			'lead_id.exists' => 'Khách hàng không tồn tại',
			'order_date.required' => 'Vui lòng chọn ngày đặt hàng',
			'order_date.date' => 'Ngày đặt hàng không hợp lệ',
			'warehouse_id.required' => 'Vui lòng chọn kho xuất',
			'warehouse_id.exists' => 'Kho không tồn tại',
			'items.required' => 'Vui lòng thêm ít nhất 1 sản phẩm',
			'items.*.product_id.required' => 'Vui lòng chọn sản phẩm',
			'items.*.product_id.exists' => 'Sản phẩm không tồn tại',
			'items.*.quantity.required' => 'Vui lòng nhập số lượng',
			'items.*.quantity.integer' => 'Số lượng phải là số nguyên',
			'items.*.quantity.min' => 'Số lượng phải lớn hơn 0',
			'items.*.unit_price.required' => 'Vui lòng nhập đơn giá',
			'items.*.unit_price.numeric' => 'Đơn giá phải là số',
			'items.*.unit_price.min' => 'Đơn giá phải lớn hơn hoặc bằng 0',
		];
	}
	/**
	 * Xử lý dữ liệu trước khi validate
	 */
	protected function prepareForValidation(): void
	{
		// Tự động tính tổng tiền nếu chưa có
		if ($this->has('items')) {
			$totalAmount = 0;
			foreach ($this->items as $item) {
				$totalAmount += ($item['quantity'] ?? 0) * ($item['unit_price'] ?? 0);
			}
			$this->merge(['total_amount' => $totalAmount]);
		}
	}
	/**
	 * Custom validation
	 */
	public function withValidator($validator): void
	{
		$validator->after(function ($validator) {
			// Kiểm tra tồn kho nếu đang tạo đơn mới
			if ($this->isMethod('POST') && $this->has('items') && $this->has('warehouse_id')) {
				$stockService = app(ProductStockService::class);
				$insufficientItems = $stockService->checkMultipleStock(
					$this->items,
					$this->warehouse_id
				);
				if (!empty($insufficientItems)) {
					foreach ($insufficientItems as $item) {
						$productName = Product::find($item['product_id'])->name ?? 'Unknown';
						$validator->errors()->add(
							'items',
							"Sản phẩm '{$productName}' không đủ tồn kho. " .
							"Cần: {$item['required']}, Có: {$item['available']}, Thiếu: {$item['shortage']}"
						);
					}
				}
			}
		});
	}
}