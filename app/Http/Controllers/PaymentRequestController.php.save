<?php

namespace App\Http\Controllers;

use App\Models\PaymentRequest;
use Illuminate\Http\Request;
use Barryvdh\DomPDF\Facade\Pdf;

class PaymentRequestController extends Controller

{
    public function invoice($id)
{
    $item = PaymentRequest::findOrFail($id);
    $user = auth()->user();

    // quyền xem giống show()
    $hasRole = method_exists($user, 'hasRole');
    $hasAnyRole = method_exists($user, 'hasAnyRole');

    $isAdmin = ($hasRole && $user->hasRole('admin'))
        || (($user->role ?? null) === 'admin')
        || ((int)($user->is_admin ?? 0) === 1);

    $isAcc = ($hasAnyRole && $user->hasAnyRole(['accounting', 'ketoan', 'ke_toan']))
        || in_array(($user->role ?? ''), ['accounting', 'ketoan', 'ke_toan'], true);

    if (!($isAdmin || $isAcc) && (int)$item->created_by !== (int)$user->id) {
        abort(403);
    }

    // chỉ cho tải khi đã "kế toán đã chi"
    if (($item->status ?? '') !== 'accounting_approved') {
        abort(403, 'Chỉ tải PDF khi kế toán đã chi.');
    }

    // map công ty -> logo + chữ ký
    $company = (string)($item->company ?? '');
    $companyKey = str_contains(mb_strtolower($company), 'egp') ? 'egp' : 'ego';

    $paths = [
        'ego' => [
            'company_name' => 'Công ty TNHH Ego Viet Nam',
            'logo' => public_path('assets/logos/ego.png'),
            'director_sig' => public_path('assets/signatures/ego_director.png'),
            'acc_sig' => public_path('assets/signatures/ego_accounting.png'),
        ],
        'egp' => [
            'company_name' => 'Công ty TNHH Thương Mại Kỹ Thuật Quốc Tế EGP',
            'logo' => public_path('assets/logos/egp.png'),
            'director_sig' => public_path('assets/signatures/egp_director.png'),
            'acc_sig' => public_path('assets/signatures/egp_accounting.png'),
        ],
    ];

    $meta = $paths[$companyKey];

    $toDataUri = function (?string $absPath) {
        if (!$absPath || !file_exists($absPath)) return null;
        $mime = mime_content_type($absPath) ?: 'image/png';
        $data = base64_encode(file_get_contents($absPath));
        return "data:$mime;base64,$data";
    };

    $logoDataUri = $toDataUri($meta['logo']);
    $directorSigDataUri = $toDataUri($meta['director_sig']);
    $accSigDataUri = $toDataUri($meta['acc_sig']);

    $pdf = Pdf::loadView('payment_requests.invoice_pdf', compact(
        'item',
        'logoDataUri',
        'directorSigDataUri',
        'accSigDataUri'
    ))->setPaper('A4', 'portrait');

    $filename = 'HoaDon_' . $item->code . '.pdf';
    return $pdf->download($filename);
}

    private function isAdmin($user): bool
    {
        return (method_exists($user, 'hasRole') && $user->hasRole('admin'))
            || (($user->role ?? null) === 'admin')
            || ((int)($user->is_admin ?? 0) === 1);
    }

    private function isAccounting($user): bool
    {
        return (method_exists($user, 'hasAnyRole') && $user->hasAnyRole(['accounting', 'ketoan', 'ke_toan']))
            || in_array(($user->role ?? ''), ['accounting', 'ketoan', 'ke_toan'], true);
    }

    public function index(Request $request)
    {
        $user = auth()->user();

        $q = PaymentRequest::query()
            ->with(['creator'])               // ✅ load người tạo
            ->orderByDesc('id');

        // User thường chỉ xem phiếu của mình
        if (!($this->isAdmin($user) || $this->isAccounting($user))) {
            $q->where('created_by', $user->id);
        }

        if ($request->filled('status')) {
            $q->where('status', $request->status);
        }

        $items = $q->paginate(20)->withQueryString();
        $companyOptions = PaymentRequest::companyOptions();

        return view('payment_requests.index', compact('items', 'companyOptions'));
    }

    public function store(Request $request)
    {
        $data = $request->validate([
            'company' => 'required|in:' . PaymentRequest::COMPANY_EGO . ',' . PaymentRequest::COMPANY_EGP,
            'receiver_name' => 'required|string|max:255',
            'department' => 'nullable|string|max:255',
            'reason' => 'required|string|max:255',
            'amount' => 'required|integer|min:1',
            'bank_info' => 'nullable|string|max:255',
        ]);

        $data['created_by'] = auth()->id();
        $data['status'] = 'draft';
        $data['code'] = 'PR-' . date('Y') . '-' . str_pad((string)(PaymentRequest::count() + 1), 5, '0', STR_PAD_LEFT);

        $pr = PaymentRequest::create($data);

        return redirect()->route('payment_requests.show', $pr->id)
            ->with('success', 'Đã tạo phiếu thành công');
    }

    public function show($id)
    {
        $item = PaymentRequest::with(['creator'])->findOrFail($id);
        $user = auth()->user();

        if (!($this->isAdmin($user) || $this->isAccounting($user)) && (int)$item->created_by !== (int)$user->id) {
            abort(403);
        }

        return view('payment_requests.show', compact('item'));
    }
    public function edit($id)
{
    $item = PaymentRequest::findOrFail($id);
    $user = auth()->user();

    // chỉ chủ phiếu sửa khi chưa hoàn thành
    if ((int)$item->created_by !== (int)$user->id) abort(403);

    // chỉ cho sửa khi chưa hoàn thành (draft / bị từ chối)
    if (!in_array($item->status, ['draft','admin_rejected','accounting_rejected'], true)) {
        return redirect()->route('payment_requests.show', $item->id)
            ->with('error', 'Phiếu đã gửi duyệt/hoàn thành nên không sửa được.');
    }

    return view('payment_requests.edit', compact('item'));
}

public function update(Request $request, $id)
{
    $item = PaymentRequest::findOrFail($id);
    $user = auth()->user();

    if ((int)$item->created_by !== (int)$user->id) abort(403);

    if (!in_array($item->status, ['draft','admin_rejected','accounting_rejected'], true)) {
        return redirect()->route('payment_requests.show', $item->id)
            ->with('error', 'Phiếu đã gửi duyệt/hoàn thành nên không sửa được.');
    }

    $data = $request->validate([
        'receiver_name' => 'required|string|max:255',
        'company'       => 'nullable|string|max:255',
        'department'    => 'nullable|string|max:255',
        'reason'        => 'required|string|max:255',
        'amount'        => 'required|integer|min:1',
        'bank_info'     => 'nullable|string|max:255',
    ]);

    $item->update($data);

    return redirect()->route('payment_requests.show', $item->id)
        ->with('success', 'Đã cập nhật phiếu.');
}

public function destroy($id)
{
    $item = PaymentRequest::findOrFail($id);
    $user = auth()->user();

    // chỉ chủ phiếu được xoá
    if ((int)$item->created_by !== (int)$user->id) abort(403);

    // chỉ xoá khi chưa hoàn thành (draft / bị từ chối)
    if (!in_array($item->status, ['draft','admin_rejected','accounting_rejected'], true)) {
        return redirect()->route('payment_requests.index')
            ->with('error', 'Phiếu đã gửi duyệt/hoàn thành nên không xoá được.');
    }

    $item->delete();

    return redirect()->route('payment_requests.index')
        ->with('success', 'Đã xoá phiếu.');
}
public function invoice($id)
{
    $item = PaymentRequest::findOrFail($id);
    $user = auth()->user();

    // Quyền xem giống show()
    $hasRole = method_exists($user, 'hasRole');
    $hasAnyRole = method_exists($user, 'hasAnyRole');

    $isAdmin = ($hasRole && $user->hasRole('admin'))
        || (($user->role ?? null) === 'admin')
        || ((int)($user->is_admin ?? 0) === 1);

    $isAcc = ($hasAnyRole && $user->hasAnyRole(['accounting', 'ketoan', 'ke_toan']))
        || in_array(($user->role ?? ''), ['accounting', 'ketoan', 'ke_toan'], true);

    if (!($isAdmin || $isAcc) && (int)$item->created_by !== (int)$user->id) {
        abort(403);
    }

    // Tên file tải xuống
    $baseName = 'Hoa-don-' . ($item->code ?? ('PR-' . $item->id));

    // Nếu có DomPDF -> tải PDF, không có -> tải HTML
    if (class_exists(\Barryvdh\DomPDF\Facade\Pdf::class)) {
        $pdf = \Barryvdh\DomPDF\Facade\Pdf::loadView('payment_requests.invoice', compact('item'));
        return $pdf->download($baseName . '.pdf');
    }

    $html = view('payment_requests.invoice', compact('item'))->render();
    return response($html, 200, [
        'Content-Type' => 'text/html; charset=UTF-8',
        'Content-Disposition' => 'attachment; filename="'.$baseName.'.html"',
    ]);
}

}
