//		$users = User::all();
//        $user = Auth::user();
//        $filters = request()->only(['search', 'region_id', 'customer_type_id', 'customer_status', 'is_potential']);
//
//        // LOGIC MỚI: Phân quyền dữ liệu
//        // 1. Nếu là Sales: Chỉ lấy khách do mình phụ trách (owner_id = user_id)
//        if ($user->hasRole('sales')) {
