                    $stt++,
                    $row->order_code,
                    $row->order_date ? \Carbon\Carbon::parse($row->order_date)->format('d/m/Y') : '',
                    $row->sales_name,
                    $row->customer_name,
                    '',
                    0,
                    'Chưa có thanh toán',
                ], null, 'A' . $r);

                $r++;
                continue;
            }

            foreach ($payments as $p) {
                $sheet->fromArray([
                    $stt++,
                    $row->order_code,
                    $row->order_date ? \Carbon\Carbon::parse($row->order_date)->format('d/m/Y') : '',
                    $row->sales_name,
                    $row->customer_name,
