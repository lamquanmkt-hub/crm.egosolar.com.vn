    public function processApproval(string $id, array $data): void
    {
        \Log::info('🔵 START processApproval', [
            'order_id' => $id,
            'action' => $data['action'],
            'user_id' => Auth::id(),
            'data' => $data
        ]);
        try {
            if ($data['action'] === 'approve') {
                $this->approveOrder($id, $data);
            } else {
                $this->rejectOrder($id, $data);
            }
            \Log::info('✅ processApproval SUCCESS');
        } catch (\Exception $e) {
            \Log::error('❌ processApproval FAILED', [
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString()
            ]);
            throw $e;
        }
    }

