    private function transitionOrderToDepartment(Order $order, string $dept, string $statusCode): void
    {
        \Log::info('Transitioning order', [
            'to_dept' => $dept,
            'status_code' => $statusCode
        ]);
        $status = OrderStatusType::where('code', $statusCode)->first();
        if (!$status) {
            \Log::error('❌ Status code not found in database', [
                'code' => $statusCode
            ]);
            throw new \Exception("Status code '{$statusCode}' không tồn tại trong database");
        }
        \Log::info('Status found', [
            'id' => $status->id,
            'name' => $status->name
        ]);
        $order->update([
            'current_department' => $dept,
            'current_status_type_id' => $status->id,
        ]);
        \Log::info('✅ Order updated in database');
    }
