<?php
namespace App\Policies;
use App\Models\CRM\Order;
use App\Models\User;
use Illuminate\Auth\Access\HandlesAuthorization;
class OrderPolicy
{
    use HandlesAuthorization;
    /**
     * Xem danh sách đơn hàng
     */
    public function viewAny(User $user): bool
    {
        // Ai có quyền đăng nhập vào CRM đều có thể xem danh sách (nhưng Controller sẽ lọc dữ liệu)
        return true;
    }
    /**
     * Xem chi tiết đơn hàng
     */
    public function view(User $user, Order $order): bool
    {
        // 1. Admin, Giám đốc, Kế toán: Được xem tất cả (để quản lý, duyệt, thu tiền)
        if ($user->hasRole(['admin', 'director', 'accounting', 'ketoan'])) {
            return true;
        }
        // 2. Sales: Chỉ xem đơn do chính mình tạo
        if ($user->hasRole('sales')) {
            return $order->created_by === $user->id;
        }
        // 3. Kho: Chỉ xem đơn đã chuyển qua kho hoặc đã hoàn tất
        if ($user->hasRole(['warehouse', 'kho'])) {
            return in_array($order->current_department, ['warehouse', 'kho', 'completed']);
        }
        return false;
    }
    /**
     * Tạo đơn hàng mới
     */
    public function create(User $user): bool
    {
        // Chỉ Sales và Admin mới tạo được đơn
        return $user->hasRole(['sales', 'admin']);
    }
    /**
     * Cập nhật đơn hàng (Sửa thông tin)
     */
    public function update(User $user, Order $order): bool
    {
        if ($user->hasRole('admin')) {
            return true;
        }
        // Sales chỉ được sửa khi đơn còn đang ở bộ phận Sales (chưa gửi duyệt)
        // và phải là người tạo đơn đó
        return $user->hasRole('sales')
            && $order->created_by === $user->id
            && $order->current_department === 'sales';
    }
    /**
     * Xóa/Hủy đơn hàng
     */
    public function delete(User $user, Order $order): bool
    {
        // Không được hủy đơn đã hoàn tất
        if ($order->current_department === 'completed') {
            return false;
        }
        // Admin có quyền hủy

        if ($user->hasRole('admin')) {
            return true;
        }
        // Sales chỉ được hủy đơn của mình khi chưa xuất kho
        // (Tùy logic công ty: Nếu đã gửi Kế toán thì có cho Sales hủy không?
        // Ở đây tạm cho phép nếu chưa hoàn tất, hoặc bạn có thể chặn nếu !== 'sales')
        return $user->hasRole('sales')
            && $order->created_by === $user->id
            && $order->current_department === 'sales';
    }
    /**
     * Gửi đơn lên duyệt (Sales -> Accounting)
     */
    public function submit(User $user, Order $order): bool
    {
        return $user->hasRole('sales')
            && $order->created_by === $user->id
            && $order->current_department === 'sales';
    }
    /**
     * Duyệt đơn hàng (Logic mới: Chỉ còn Kế toán duyệt)
     */
    public function approve(User $user, Order $order): bool
    {
        $dept = $order->current_department;
        // Admin quyền lực tối cao
        if ($user->hasRole('admin')) {
            return true;
        }
        // Nếu đơn đang ở 'accounting' (hoặc 'ketoan') -> User role 'accounting' được duyệt
        if (in_array($dept, ['accounting', 'ketoan']) && $user->hasRole(['accounting', 'ketoan'])) {
            return true;
        }
        // Đã xóa logic duyet1, duyet2
        return false;
    }
    /**
     * Xuất kho (Warehouse)
     */
    public function ship(User $user, Order $order): bool
    {
        // Chỉ Admin hoặc Kho mới được xuất
        // Và đơn phải đang nằm ở bộ phận Kho
        return $user->hasRole(['warehouse', 'kho', 'admin'])
            && in_array($order->current_department, ['warehouse', 'kho']);
    }
    /**
     * Ghi nhận thanh toán
     */
    public function recordPayment(User $user, Order $order): bool
    {
        // Chỉ Kế toán hoặc Admin
        return $user->hasRole(['accounting', 'ketoan', 'admin']);
    }
    /**
     * Xem báo cáo
     */
    public function viewReports(User $user): bool
    {
        // Giám đốc, Admin, Kế toán
        return $user->hasRole(['admin', 'management', 'giamdoc', 'accounting', 'ketoan']);
    }
    /**
     * Xuất Excel
     */
    public function export(User $user): bool
    {
        // Admin, Kế toán, Giám đốc, Kho
        return $user->hasRole(['admin', 'management', 'accounting', 'warehouse']);
    }
}