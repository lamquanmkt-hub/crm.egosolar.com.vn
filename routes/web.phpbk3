| Debug
|--------------------------------------------------------------------------
*/

Route::get('/debug-product-tables', function () {
    $tables = collect(\DB::select("SHOW TABLES"))->map(function ($row) {
        return array_values((array)$row)[0];
    });

    $needles = ['product', 'crm_product'];

    $candidates = $tables->filter(function ($t) use ($needles) {
        $lt = strtolower($t);
        foreach ($needles as $n) if (str_contains($lt, $n)) return true;
        return false;
    })->values();

    $result = [];

    foreach ($candidates as $t) {
        try {
            $cols = collect(\DB::select("SHOW COLUMNS FROM `$t`"))
                ->pluck('Field')
                ->map(fn($c) => strtolower($c))
                ->values();

            $hasName = $cols->contains('name') || $cols->contains('product_name') || $cols->contains('title');

            $result[] = [
                'table' => $t,
                'has_name_like' => $hasName,
                'cols' => $cols->take(20),
            ];
        } catch (\Throwable $e) {
            $result[] = ['table' => $t, 'error' => $e->getMessage()];
        }
    }

    return $result;
})->middleware('auth');


Route::get('/debug-products-tables', function () {
    $tables = collect(DB::select("SHOW TABLES"))->map(function ($row) {
        return array_values((array)$row)[0];
    });

    $candidates = $tables->filter(fn($t) => str_contains(strtolower($t), 'product'))->values();

    return [
        'candidates' => $candidates
    ];
})->middleware('auth');
Route::get('/ping-route', fn() => 'OK PING ROUTE');

Route::get('/debug-inventory', function () {
    $dbName = DB::getDatabaseName();
    $tables = collect(DB::select("SHOW TABLES"))->map(function ($row) {
        return array_values((array)$row)[0];
    });

    $candidates = $tables->filter(function ($t) {
        $t = strtolower($t);
        return str_contains($t, 'invent')
            || str_contains($t, 'stock')
            || str_contains($t, 'warehouse')
            || str_contains($t, 'kho');
    })->values();

    return [
        'db' => $dbName,
        'tables_count' => $tables->count(),
        'candidate_tables' => $candidates,
    ];
})->middleware('auth');

