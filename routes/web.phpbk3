*/
Route::middleware(['auth'])->group(function () {
    Route::get('/profile', [UserController::class, 'profile'])->name('users.profile');
    Route::get('/profile/edit', [UserController::class, 'editProfile'])->name('users.profile-edit');
    Route::put('/profile/update', [UserController::class, 'updateProfile'])->name('users.profile-update');

    Route::post('/profile/avatar', [UserController::class, 'updateAvatar'])->name('users.profile.avatar');

    Route::post('/push/subscribe', function (Request $request) {
        $request->user()->updatePushSubscription(
            $request->endpoint,
            $request->publicKey,
            $request->authToken,
            $request->contentEncoding
        );
        return response()->json(['ok' => true]);
    })->name('push.subscribe');

    Route::post('/push/unsubscribe', function (Request $request) {
        $request->user()->deletePushSubscription($request->endpoint);
        return response()->json(['ok' => true]);
    })->name('push.unsubscribe');
});


/*
|--------------------------------------------------------------------------
| MODULE CÔNG TRÌNH + ĐƠN VẬT TƯ
| (Cho phép các role vào xem, còn duyệt thì check role từng nút/action)
|--------------------------------------------------------------------------
*/
Route::middleware(['auth', 'role:ky_thuat|accounting|admin|warehouse'])->group(function () {

    // ======================
    // CÔNG TRÌNH
    // ======================
    Route::get('/cong-trinh', function () {
        $sites = Site::orderBy('id', 'desc')->get();
        return view('sites.index', compact('sites'));
    });

    Route::get('/cong-trinh/tao', fn() => view('sites.create'));

    Route::post('/cong-trinh', function (Request $request) {
        $data = $request->validate([
            'name' => 'required|string|max:255',
            'address' => 'nullable|string|max:255',
            'contact_name' => 'nullable|string|max:255',
            'contact_phone' => 'nullable|string|max:50',
            'note' => 'nullable|string',
        ]);

        Site::create($data);
        return redirect('/cong-trinh')->with('success', 'Đã tạo công trình!');
    });

    Route::get('/cong-trinh/{id}/sua', function ($id) {
        $site = Site::findOrFail($id);
        return view('sites.edit', compact('site'));
    });

    Route::post('/cong-trinh/{id}/cap-nhat', function (Request $request, $id) {
        $site = Site::findOrFail($id);

        $data = $request->validate([
            'name' => 'required|string|max:255',
            'address' => 'nullable|string|max:255',
            'contact_name' => 'nullable|string|max:255',
            'contact_phone' => 'nullable|string|max:50',
            'note' => 'nullable|string',
        ]);

        $site->update($data);
        return redirect('/cong-trinh')->with('success', 'Đã cập nhật công trình!');
    });

    Route::post('/cong-trinh/{id}/xoa', function ($id) {
        $site = Site::findOrFail($id);
        $site->delete();
        return redirect('/cong-trinh')->with('success', 'Đã xoá công trình!');
    });

    // ======================
    // ĐƠN VẬT TƯ - LIST
    // ======================
    Route::get('/don-vat-tu', function () {
        $requests = MaterialRequest::orderBy('id', 'desc')->get();
        return view('material_requests.index', compact('requests'));
    });

    // ======================
    // --- ĐƠN VẬT TƯ ---
    Route::get('/don-vat-tu', function () {
        $requests = MaterialRequest::orderBy('id', 'desc')->get();
        return view('material_requests.index', compact('requests'));
    });

    Route::get('/don-vat-tu/tao', function () {

        $sites = \App\Models\Site::orderBy('name')->get();
        $warehouses = DB::table('crm_warehouses')->orderBy('name')->get();

        // ✅ tồn kho theo bảng stock + join products
       // ====== INVENTORY: tự dò tên cột số lượng trong crm_product_stock ======
$stockColumns = collect(\Illuminate\Support\Facades\DB::select("SHOW COLUMNS FROM crm_product_stock"))
    ->pluck('Field')
    ->map(fn($c) => strtolower($c));

$qtyCol = null;
foreach (['quantity','qty','stock','on_hand','available','remain','remaining','balance','in_stock'] as $c) {
    if ($stockColumns->contains($c)) { $qtyCol = $c; break; }
}

// fallback: nếu không tìm được thì lấy cột số cuối cùng kiểu “qty/quantity” (đỡ chết trang)
if (!$qtyCol) {
    $qtyCol = $stockColumns->first(fn($c) => str_contains($c, 'qty') || str_contains($c,'quant')) ?? null;
}

if (!$qtyCol) {
    // không tìm được thì cho rỗng để trang vẫn vào được
    $products_inventories = collect([]);
} else {
    $products_inventories = \Illuminate\Support\Facades\DB::table('crm_product_stock')
        ->select(
            'crm_product_stock.warehouse_id',
            'crm_product_stock.product_id',
            "crm_product_stock.$qtyCol as quantity"
        )
        ->where("crm_product_stock.$qtyCol", '>', 0)
        ->orderBy('crm_product_stock.product_id')
        ->get();
}


        return view('material_requests.create', compact('sites','warehouses','products_inventories'));
    })->middleware(['role:ky_thuat|admin']);

});

    // ======================
    // ĐƠN VẬT TƯ - STORE (DRAFT)
    // ======================
    Route::post('/don-vat-tu', function (Request $request) {

        $request->validate([
            'site_id' => 'required',
            'note' => 'nullable|string',
        ]);

        $items = collect($request->items ?? [])
            ->filter(fn($it) => !empty($it['product_id']) && !empty($it['qty']))
            ->values()
            ->all();

        if (count($items) == 0) {
            return back()->withErrors(['items' => 'Vui lòng chọn ít nhất 1 vật tư và số lượng.'])->withInput();
        }

        foreach ($items as $it) {
            if (!is_numeric($it['qty']) || $it['qty'] <= 0) {
                return back()->withErrors(['items' => 'Số lượng phải > 0'])->withInput();
            }
        }

        $mr = MaterialRequest::create([
            'site_id' => $request->site_id,
            'created_by' => auth()->id(),
            'status' => 'DRAFT',
            'note' => $request->note,
        ]);

        foreach ($items as $item) {
            MaterialRequestItem::create([
                'material_request_id' => $mr->id,
                'product_id' => $item['product_id'],
                'qty' => $item['qty'],
                'note' => $item['note'] ?? null,
            ]);
        }

        return redirect('/don-vat-tu')->with('success', 'Đã tạo đơn vật tư!');
    });

    // ======================
    // GỬI DUYỆT (DRAFT -> SUBMITTED)
    // ======================
    Route::post('/don-vat-tu/{id}/gui-duyet', function ($id) {
        $mr = MaterialRequest::findOrFail($id);

        if ($mr->status !== 'DRAFT') {
            return redirect('/don-vat-tu')->with('success', 'Đơn này đã gửi duyệt rồi!');
        }

        $mr->update(['status' => 'SUBMITTED']);
        return redirect('/don-vat-tu')->with('success', 'Đã gửi duyệt đơn vật tư!');
    });

    // ======================
    // XEM CHI TIẾT
    // ⚠️ Nếu model chưa có relationship items()/site() thì đừng with()
    // ======================
    Route::get('/don-vat-tu/{id}', function ($id) {
        $mr = MaterialRequest::findOrFail($id);
        return view('material_requests.show', compact('mr'));
    });

    // ======================
    // SỬA / CẬP NHẬT / XOÁ (chỉ DRAFT)
    // ======================
    Route::get('/don-vat-tu/{id}/sua', function ($id) {
        $mr = MaterialRequest::with('items')->findOrFail($id);

        if ($mr->status !== 'DRAFT') {
            return redirect('/don-vat-tu')->withErrors('Chỉ được sửa khi đơn còn ở trạng thái Nháp (DRAFT).');
        }

        $sites = Site::orderBy('id', 'desc')->get();
        $products = Product::orderBy('id', 'desc')->get();

        return view('material_requests.edit', compact('mr', 'sites', 'products'));
    });

    Route::post('/don-vat-tu/{id}/cap-nhat', function (Request $request, $id) {
        $mr = MaterialRequest::with('items')->findOrFail($id);

        if ($mr->status !== 'DRAFT') {
            return redirect('/don-vat-tu')->withErrors('Chỉ được cập nhật khi đơn còn ở trạng thái Nháp (DRAFT).');
        }

        $request->validate([
            'site_id' => 'required',
            'note' => 'nullable|string',
        ]);

        $items = collect($request->items ?? [])
            ->filter(fn($it) => !empty($it['product_id']) && !empty($it['qty']))
            ->values()
            ->all();

        if (count($items) == 0) {
            return back()->withErrors(['items' => 'Vui lòng chọn ít nhất 1 vật tư và số lượng.'])->withInput();
        }

        foreach ($items as $it) {
            if (!is_numeric($it['qty']) || $it['qty'] <= 0) {
                return back()->withErrors(['items' => 'Số lượng phải > 0'])->withInput();
            }
        }

        $mr->update([
            'site_id' => $request->site_id,
            'note' => $request->note,
        ]);

        MaterialRequestItem::where('material_request_id', $mr->id)->delete();

        foreach ($items as $item) {
            MaterialRequestItem::create([
                'material_request_id' => $mr->id,
                'product_id' => $item['product_id'],
                'qty' => $item['qty'],
                'note' => $item['note'] ?? null,
            ]);
        }

        return redirect('/don-vat-tu')->with('success', 'Đã cập nhật đơn vật tư!');
    });

    Route::post('/don-vat-tu/{id}/xoa', function ($id) {
        $mr = MaterialRequest::findOrFail($id);

        if ($mr->status !== 'DRAFT') {
            return redirect('/don-vat-tu')->withErrors('Chỉ được xoá khi đơn còn ở trạng thái Nháp (DRAFT).');
        }

        MaterialRequestItem::where('material_request_id', $mr->id)->delete();
        $mr->delete();

        return redirect('/don-vat-tu')->with('success', 'Đã xoá đơn vật tư!');
    });

    Route::get('/theo-doi-trang-thai', fn() => 'Theo dõi trạng thái - OK');



/*
|--------------------------------------------------------------------------
| DUYỆT NGAY TRÊN TRANG /don-vat-tu (Kế toán -> Admin -> Warehouse)
|--------------------------------------------------------------------------
*/

// Kế toán duyệt: SUBMITTED -> ACC_APPROVED
Route::post('/don-vat-tu/{id}/ke-toan-duyet', function ($id) {
    if (!auth()->user()->hasRole('accounting')) abort(403);

    $mr = MaterialRequest::findOrFail($id);

    if ($mr->status !== 'SUBMITTED') {
        return back()->with('success', 'Đơn không còn ở trạng thái chờ kế toán duyệt!');
    }

    $mr->update(['status' => 'ACC_APPROVED']);
    return back()->with('success', 'Kế toán đã duyệt đơn vật tư!');
})->middleware('auth');

// Admin duyệt: ACC_APPROVED -> ADMIN_APPROVED
Route::post('/don-vat-tu/{id}/admin-duyet', function ($id) {
    if (!auth()->user()->hasRole('admin')) abort(403);

    $mr = MaterialRequest::findOrFail($id);

    if ($mr->status !== 'ACC_APPROVED') {
        return back()->with('success', 'Đơn không còn ở trạng thái chờ admin duyệt!');
    }

    $mr->update(['status' => 'ADMIN_APPROVED']);
    return back()->with('success', 'Admin đã duyệt đơn vật tư!');
})->middleware('auth');

// Kho xuất kho: ADMIN_APPROVED -> EXPORTED (chưa trừ kho)
Route::post('/don-vat-tu/{id}/xuat-kho', function ($id) {
    if (!auth()->user()->hasRole('warehouse')) abort(403);

    $mr = MaterialRequest::findOrFail($id);

    if ($mr->status !== 'ADMIN_APPROVED') {
        return back()->with('success', 'Đơn không còn ở trạng thái chờ xuất kho!');
    }

    $mr->update(['status' => 'EXPORTED']);
    return back()->with('success', 'Đã xuất kho (tạm thời chỉ cập nhật trạng thái)!');
})->middleware('auth');


