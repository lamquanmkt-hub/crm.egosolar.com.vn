    Route::put('/payment-requests/{id}', [PaymentRequestController::class, 'update'])->whereNumber('id')->name('payment_requests.update');
    Route::delete('/payment-requests/{id}', [PaymentRequestController::class, 'destroy'])->whereNumber('id')->name('payment_requests.destroy');

    Route::get('/payment-requests/{id}/invoice', [PaymentRequestController::class, 'invoice'])->whereNumber('id')->name('payment_requests.invoice');

    Route::get('/payment-requests/demo-create', [PaymentRequestController::class, 'demoCreate'])->name('payment_requests.demo_create');

    Route::post('/payment-requests/{id}/submit', [PaymentRequestApprovalController::class, 'submit'])->name('payment_requests.submit');
    Route::post('/payment-requests/{id}/admin-approve', [PaymentRequestApprovalController::class, 'adminApprove'])->name('payment_requests.admin_approve');
    Route::post('/payment-requests/{id}/admin-reject', [PaymentRequestApprovalController::class, 'adminReject'])->name('payment_requests.admin_reject');
    Route::post('/payment-requests/{id}/acc-approve', [PaymentRequestApprovalController::class, 'accApprove'])->name('payment_requests.acc_approve');
    Route::post('/payment-requests/{id}/acc-reject', [PaymentRequestApprovalController::class, 'accReject'])->name('payment_requests.acc_reject');

    Route::post('/payment-requests/{paymentRequest}/attachments', [PaymentAttachmentController::class, 'store'])->name('payment-attachments.store');
});


/*
|--------------------------------------------------------------------------
| Marketing
|--------------------------------------------------------------------------
*/
Route::middleware(['auth', 'role:marketing|marketing_manager|admin'])
    ->prefix('marketing')
    ->name('marketing.')
    ->group(function () {

        // Dashboard
        Route::get('/dashboard', [\App\Http\Controllers\Marketing\MarketingDashboardController::class, 'index'])
            ->name('dashboard');

        // Budget
        Route::get('/budget', [MarketingBudgetController::class, 'index'])->name('budget');
        Route::post('/budget', [MarketingBudgetController::class, 'store'])->name('budget.store');

        Route::middleware(['role:marketing_manager|admin'])->group(function () {
            Route::get('/budget/{id}/edit', [MarketingBudgetController::class, 'edit'])->name('budget.edit');
            Route::put('/budget/{id}', [MarketingBudgetController::class, 'update'])->name('budget.update');
            Route::delete('/budget/{id}', [MarketingBudgetController::class, 'destroy'])->name('budget.destroy');
        });

        // Metrics + Campaign
        Route::post('/metrics', [MarketingMetricController::class, 'store'])->name('metrics.store');
        Route::post('/campaigns', [MarketingCampaignController::class, 'store'])->name('campaigns.store');

        // Reports
        Route::prefix('reports')->name('reports.')->group(function () {

            // Content calendar
            Route::get('/content-calendar', [ContentCalendarController::class, 'index'])->name('content-calendar');
            Route::post('/content-calendar', [ContentCalendarController::class, 'store'])->name('content-calendar.store');

            Route::get('/content-calendar/{id}', [ContentCalendarController::class, 'show'])
                ->whereNumber('id')->name('content-calendar.show');

            Route::delete('/content-calendar/{id}', [ContentCalendarController::class, 'destroy'])
                ->whereNumber('id')->name('content-calendar.destroy');

            Route::put('/content-calendar/{id}', [ContentCalendarController::class, 'update'])
                ->whereNumber('id')->name('content-calendar.update');

            Route::post('/content-calendar/{id}/files', [ContentCalendarController::class, 'uploadFile'])
                ->whereNumber('id')->name('content-calendar.files');

            Route::post('/content-calendar/{id}/submit', [ContentCalendarController::class, 'submit'])
                ->whereNumber('id')->name('content-calendar.submit');

            Route::post('/content-calendar/{id}/approve', [ContentCalendarController::class, 'approve'])
                ->whereNumber('id')
                ->middleware('role:marketing_manager|admin')
                ->name('content-calendar.approve');

            // ✅ Weekly tasks
            Route::get('/weekly-tasks', [WeeklyTaskController::class, 'index'])
                ->name('weekly-tasks');

            Route::get('/weekly-tasks/create', [WeeklyTaskController::class, 'create'])
                ->name('weekly-tasks.create');

            Route::post('/weekly-tasks', [WeeklyTaskController::class, 'store'])
                ->name('weekly-tasks.store');
        });
    });
