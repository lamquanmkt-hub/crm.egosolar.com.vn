<?php
namespace Database\Seeders;
use Illuminate\Database\Seeder;
use Spatie\Permission\Models\Role;
use Spatie\Permission\Models\Permission;
use App\Models\User;
use Illuminate\Support\Facades\Hash;
class RolePermissionSeeder extends Seeder
{
	/**
	 * Run the database seeds.
	 */
	public function run(): void
	{
		// Xóa cache role/permission cũ
		app()[\Spatie\Permission\PermissionRegistrar::class]->forgetCachedPermissions();
		// ====== PERMISSIONS ======
		$permissions = [
			// Customer & Lead
			'customer.view', 'customer.create', 'customer.update', 'customer.delete',
			'lead.create', 'lead.view', 'lead.update', 'lead.delete', 'lead.rate',
			// Order
			'order.create', 'order.view', 'order.update.status',
			'order.approve.accounting', 'order.approve.director',
			'order.request.warehouse',
			// Inventory/Warehouse
			'inventory.view', 'inventory.export',
			// Payment
			'payment.record', 'payment.approve',
			// Reports
			'report.view',
			// Product
			'products.manage',
			'categories.manage',
			// Media
			'media.view', 'media.upload', 'media.delete',
			// User Management
			'user.view', 'user.create', 'user.update', 'user.delete',
			// Product CRUD
			'product.view', 'product.create', 'product.update', 'product.delete',
			// Categories CRUD
			'category.view', 'category.create', 'category.update', 'category.delete',
		];
		foreach ($permissions as $perm) {
			Permission::firstOrCreate(['name' => $perm]);
		}
		// ====== ROLES ======
		$roles = [
			'admin' => $permissions, // Admin full quyền
			'marketing' => [
				'customer.view', 'lead.create', 'lead.view', 'lead.update', 'lead.rate', 'report.view', 'media.view'
			],
			'sales' => [
				'customer.view', 'lead.update', 'order.create', 'order.view', 'order.update.status', 'order.request.warehouse'
			],
			'ketoan' => [
				'order.view', 'order.approve.accounting', 'payment.record', 'payment.approve', 'report.view'
			],
			'kho' => [
				'order.view', 'inventory.view', 'inventory.export', 'order.update.status', 'products.manage', 'categories.manage','media.view', 'media.upload'
			],
			'giamsat' => [
				'order.view', 'order.approve.director', 'report.view'
			]
		];
		foreach ($roles as $roleName => $rolePerms) {
			$role = Role::firstOrCreate(['name' => $roleName]);
			$role->syncPermissions($rolePerms);
		}
		// ====== USERS DEMO ======
		$users = [
			[
				'name' => 'Admin EGO SOLAR',
				'email' => 'admin@egosolar.vn',
				'password' => '12345678',
				'role' => 'admin',
			],
			[
				'name' => 'Marketing Team',
				'email' => 'marketing@egosolar.vn',
				'password' => '12345678',
				'role' => 'marketing',
			],
			[
				'name' => 'Sales Team',
				'email' => 'sales@egosolar.vn',
				'password' => '12345678',
				'role' => 'sales',
			],
			[
				'name' => 'Kế toán EGO SOLAR',
				'email' => 'ketoan@egosolar.vn',
				'password' => '12345678',
				'role' => 'ketoan',
			],
			[
				'name' => 'Thủ kho EGO SOLAR',
				'email' => 'kho@egosolar.vn',
				'password' => '12345678',
				'role' => 'kho',
			],
			[
				'name' => 'Giám sát/Ban giám đốc',
				'email' => 'giamsat@egosolar.vn',
				'password' => '12345678',
				'role' => 'giamsat',
			]
		];
		foreach ($users as $userData) {
			$user = User::firstOrCreate(
				['email' => $userData['email']],
				[
					'name' => $userData['name'],
					'password' => Hash::make($userData['password']),
				]
			);
			$user->syncRoles($userData['role']);
		}
		echo "✅ RolePermissionSeeder: seeded successfully.\n";
	}
}
