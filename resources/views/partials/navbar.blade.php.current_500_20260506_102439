<script>
(function () {
    const openSidebarBtn = document.getElementById('openSidebarBtn');
    if (openSidebarBtn) {
        openSidebarBtn.addEventListener('click', () => {
            if (window.EgoSidebar?.open) window.EgoSidebar.open();
        });
    }

    const badge = document.getElementById('notifyBadge');
    const list  = document.getElementById('notifyList');
    const readAllBtn = document.getElementById('notifyReadAllBtn');
    const pushBtn = document.getElementById('pushEnableBtn');

    if (!badge || !list) return;

    const csrf = "{{ csrf_token() }}";
    const VAPID_PUBLIC_KEY = "{{ config('webpush.vapid.public_key') }}";

    function urlBase64ToUint8Array(base64String) {
        const padding = '='.repeat((4 - base64String.length % 4) % 4);
        const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
        const rawData = atob(base64);
        const outputArray = new Uint8Array(rawData.length);
        for (let i = 0; i < rawData.length; ++i) outputArray[i] = rawData.charCodeAt(i);
        return outputArray;
    }

    async function registerServiceWorker() {
        return await navigator.serviceWorker.register('/service-worker.js');
    }

    async function subscribePush() {
        if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
            alert('Trình duyệt không hỗ trợ push.');
            return;
        }

        const permission = await Notification.requestPermission();
        if (permission !== 'granted') {
            alert('Bạn cần bấm Allow để bật thông báo.');
            return;
        }

        const reg = await registerServiceWorker();

        const sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY),
        });

        const json = sub.toJSON();

        await fetch("{{ route('push.subscribe') }}", {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': csrf,
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({
                endpoint: sub.endpoint,
                publicKey: json.keys.p256dh,
                authToken: json.keys.auth,
                contentEncoding: (PushManager.supportedContentEncodings || ['aesgcm'])[0],
            })
        });

        if (pushBtn) {
            pushBtn.innerHTML = '<i class="bi bi-check2-circle"></i><span>Đã bật</span>';
        }
    }

    if (pushBtn) {
        pushBtn.addEventListener('click', () => {
            subscribePush().catch(() => alert('Bật thông báo thất bại'));
        });
    }

    let lastToastId = localStorage.getItem('notify_last_toast_id') || '0';
    let inited = false;

    function esc(s){
        return (s ?? '').toString().replace(/[&<>"']/g, m => ({
            '&':'&amp;',
            '<':'&lt;',
            '>':'&gt;',
            '"':'&quot;',
            "'":'&#39;'
        }[m]));
    }

    let audioCtx = null;

    async function ensureAudio(){
        try{
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return null;

            if (!audioCtx) audioCtx = new AudioCtx();
            if (audioCtx.state === 'suspended') await audioCtx.resume();
            return audioCtx;
        }catch(e){
            return null;
        }
    }

    async function playTing(){
        const ctx = await ensureAudio();
        if (!ctx) return;

        try{
            const o = ctx.createOscillator();
            const g = ctx.createGain();
            o.type = 'sine';
            o.frequency.value = 880;
            g.gain.value = 0.12;
            o.connect(g);
            g.connect(ctx.destination);
            o.start();
            setTimeout(() => { o.stop(); }, 140);
        }catch(e){}
    }

    const notifyBtn = document.getElementById('notifyDropdownBtn');
    if (notifyBtn) {
        notifyBtn.addEventListener('click', () => ensureAudio());
    }

    function showToast(title, message, link){
        const container = document.getElementById('notifyToastContainer');
        if (!container) return;

        const id = 't' + Date.now();

        const html = `
          <div id="${id}" class="toast show ego-toast mb-2" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
              <div class="ego-noti-icon me-2" style="width:34px;height:34px;font-size:15px;">
                <i class="bi bi-bell-fill"></i>
              </div>
              <strong class="me-auto">${esc(title || 'Thông báo')}</strong>
              <small class="text-muted">mới</small>
              <button type="button" class="btn-close ms-2 mb-1" aria-label="Close"></button>
            </div>
            <div class="toast-body">
              <div class="mb-2">${esc(message || '')}</div>
              ${link && link !== '#' ? `<a href="${esc(link)}" class="btn btn-sm btn-primary rounded-pill px-3">Xem ngay</a>` : ''}
            </div>
          </div>
        `;

        container.insertAdjacentHTML('afterbegin', html);

        const el = document.getElementById(id);
        const closeBtn = el.querySelector('.btn-close');

        closeBtn.addEventListener('click', () => el.remove());

        setTimeout(() => {
            if (el) el.remove();
        }, 6000);
    }

    async function fetchUnreadCount(){
        const res = await fetch("{{ route('notifications.unread-count') }}", {
            headers: {'X-Requested-With':'XMLHttpRequest'}
        });

        const data = await res.json();
        const count = Number(data.count ?? 0);

        if (count > 0) {
            badge.style.display = 'inline-flex';
            badge.textContent = count > 99 ? '99+' : String(count);
        } else {
            badge.style.display = 'none';
        }
    }

    async function fetchList(){
        const res = await fetch("{{ route('notifications.json') }}?limit=10", {
            headers: {'X-Requested-With':'XMLHttpRequest'}
        });

        const data = await res.json();
        const items = data.items?.data ?? [];

        if (items.length) {
            const newest = items[0];
            const newestId = String(newest.id ?? '0');

            if (inited && newestId !== '0' && newestId !== lastToastId) {
                const title = newest.title ?? 'Thông báo';
                const msg   = newest.message ?? '';
                const link  = newest.order_id ? `/orders/${newest.order_id}` : '#';

                playTing();
                showToast(title, msg, link);

                lastToastId = newestId;
                localStorage.setItem('notify_last_toast_id', newestId);
            }
        }

        if (!items.length) {
            list.innerHTML = `
                <div class="ego-noti-empty">
                    <div class="ego-noti-empty-icon">
                        <i class="bi bi-bell-slash"></i>
                    </div>
                    <div class="fw-bold text-dark">Chưa có thông báo</div>
                    <div class="small mt-1">Khi có thông báo mới, nó sẽ hiện tại đây.</div>
                </div>
            `;
            return;
        }

        list.innerHTML = items.map(n => {
            const id = n.id;
            const title = n.title ?? 'Thông báo';
            const body  = n.message ?? '';
            const link = n.order_id ? `/orders/${n.order_id}` : '{{ route('notifications.index') }}';
            const isRead = (n.is_read === true) || (Number(n.is_read ?? 0) === 1);
            const createdAt = n.created_at ?? '';
            const icon = n.order_id ? 'bi-receipt' : 'bi-bell-fill';

            return `
                <a href="${esc(link)}"
                   class="ego-noti-item ${isRead ? '' : 'unread'}"
                   data-id="${esc(id)}"
                   data-read="${isRead ? 'read' : 'unread'}">
                    <div class="ego-noti-icon">
                        <i class="bi ${icon}"></i>
                    </div>

                    <div class="ego-noti-content">
                        <div class="ego-noti-item-title">${esc(title)}</div>
                        ${body ? `<div class="ego-noti-message">${esc(body)}</div>` : ''}
                        ${createdAt ? `<div class="ego-noti-time">${esc(createdAt)}</div>` : ''}
                    </div>

                    ${isRead ? '' : '<div class="ego-noti-unread-dot"></div>'}
                </a>
            `;
        }).join('');

        list.querySelectorAll('a.ego-noti-item').forEach(a => {
            a.addEventListener('click', async (e) => {
                const id = a.getAttribute('data-id');
                if (!id) return;

                e.preventDefault();

                try {
                    await fetch(`{{ url('/notifications') }}/${id}/read`, {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': csrf,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                } catch (err) {}

                window.location = a.getAttribute('href');
            });
        });

        bindNotificationTabs();
    }

    function bindNotificationTabs() {
        const tabs = document.querySelectorAll('.ego-noti-tab');
        const notiItems = document.querySelectorAll('.ego-noti-item');

        tabs.forEach(tab => {
            tab.onclick = function () {
                const filter = tab.dataset.filter;

                tabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');

                notiItems.forEach(item => {
                    if (filter === 'all') {
                        item.style.display = 'grid';
                    } else {
                        item.style.display = item.dataset.read === 'unread' ? 'grid' : 'none';
                    }
                });
            };
        });
    }

    async function refreshAll(){
        try {
            await Promise.all([fetchUnreadCount(), fetchList()]);
        } catch (e) {}
        inited = true;
    }

    if (readAllBtn) {
        readAllBtn.addEventListener('click', async () => {
            try {
                await fetch(`{{ route('notifications.mark-all-read') }}`, {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': csrf,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
            } catch (e) {}

            refreshAll();
        });
    }

    refreshAll();
    setInterval(refreshAll, 2000);
})();
</script>

@push('scripts')
<script>
document.addEventListener('DOMContentLoaded', function () {
    const MODAL_ID = 'companyAnnouncementModal';
    const ACK_BTN_ID = 'announceAcknowledgeBtn';

    const TTL_MS = 30 * 60 * 1000;
    const KEY_NEXT_SHOW = 'ego_announce_tatnien_next_show_at_v1';

    try {
        const modalEl = document.getElementById(MODAL_ID);
        if (!modalEl) return;

        const now = Date.now();
        const nextShowAt = Number(localStorage.getItem(KEY_NEXT_SHOW) || '0');
        if (nextShowAt && now < nextShowAt) return;

        if (!(window.bootstrap && bootstrap.Modal)) return;

        const m = new bootstrap.Modal(modalEl, { backdrop: 'static', keyboard: true });
        m.show();

        const setNextTime = () => {
            localStorage.setItem(KEY_NEXT_SHOW, String(Date.now() + TTL_MS));
        };

        const ackBtn = document.getElementById(ACK_BTN_ID);
        if (ackBtn) {
            ackBtn.addEventListener('click', () => {
                setNextTime();
                m.hide();
            }, { once: true });
        }

        modalEl.addEventListener('hidden.bs.modal', () => {
            setNextTime();
        }, { once: true });

    } catch (e) {}
});
</script>
@endpush