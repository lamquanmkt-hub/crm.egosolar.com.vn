px !important;\n  background:rgba(34,211,238,.16) !important;\n  border:1px solid rgba(34,211,238,.30) !important;\n  color:#d7fff8 !important;\n  font-size:11px !important;\n  font-weight:900 !important;\n  line-height:1 !important;\n  box-shadow:none !important;\n  vertical-align:middle !important;\n}\n\n.ego-link > .ego-count-badge{\n  margin-left:auto !important;\n  flex:0 0 auto !important;\n}\n\n.ego-sublink > .ego-count-badge{\n  float:right !important;\n  margin-top:-2px !important;\n}\n\n.ego-sidebar.ego-collapsed .ego-count-badge{\n  display:none !important;\n}\n/* EGO_PENDING_BADGE_CSS_END */\n\n</style>\n\n<!-- EGO_REMOVE_CHAT_BUBBLE_START -->\n<style>\n/* Ẩn nút chat nổi góc phải dưới */\n#chatWidget,\n#chat-widget,\n.chat-widget,\n.chat-popup,\n.chat-box,\n.chat-panel,\n.chat-float,\n.floating-chat,\n.chat-launcher,\n.chat-toggle,\n.chat-fab,\n[data-chat-widget],\n[data-chat-toggle] {\n    display: none !important;\n    visibility: hidden !important;\n    pointer-events: none !important;\n}\n</style>\n\n<script>\n(function () {\n    function removeChatBubble() {\n        document.querySelectorAll(\n            '#chatWidget,#chat-widget,.chat-widget,.chat-popup,.chat-box,.chat-panel,.chat-float,.floating-chat,.chat-launcher,.chat-toggle,.chat-fab,[data-chat-widget],[data-chat-toggle]'\n        ).forEach(function (el) {\n            el.remove();\n        });\n\n        document.querySelectorAll('button, a, div').forEach(function (el) {\n            var st = window.getComputedStyle(el);\n            var rect = el.getBoundingClientRect();\n\n            var isFixed = st.position === 'fixed';\n            var nearRight = rect.right > window.innerWidth - 120;\n            var nearBottom = rect.bottom > window.innerHeight - 120;\n            var sizeOk = rect.width >= 42 && rect.width <= 90 && rect.height >= 42 && rect.height <= 90;\n            var round = parseFloat(st.borderRadius) >= 20;\n            var hasBlueBg = (st.backgroundColor || '').includes('rgb');\n\n            if (isFixed && nearRight && nearBottom && sizeOk && round && hasBlueBg) {\n                el.remove();\n            }\n        });\n    }\n\n    document.addEventListener('DOMContentLoaded', removeChatBubble);\n    removeChatBubble();\n    setInterval(removeChatBubble, 500);\n})();\n</script>\n<!-- EGO_REMOVE_CHAT_BUBBLE_END -->\n\n\n\n{{-- EGO_FORCE_SALES_SITE_MENU_START --}}\n@php\n    $egoUser = auth()->user();\n    $egoRole = strtolower((string)($egoUser->role ?? ''));\n\n    $egoIsSalesForSiteMenu =\n        (method_exists($egoUser, 'hasAnyRole') && $egoUser->hasAnyRole(['sales', 'sales_manager', 'warehouse']))\n        || in_array($egoRole, ['sales', 'sales_manager'], true);\n\n    $egoIsAdminForSiteMenu =\n        (method_exists($egoUser, 'hasRole') && $egoUser->hasRole('admin'))\n        || $egoRole === 'admin'\n        || ((int)($egoUser->is_admin ?? 0) === 1);\n@endphp\n\n@if(auth()->check() && ($egoIsSalesForSiteMenu || $egoIsAdminForSiteMenu))\n<style>\n    .ego-force-site-menu-item {\n        animation: egoForceSiteMenuIn .22s ease both;\n    }\n\n    @keyframes egoForceSiteMenuIn {\n        from {\n            opacity: 0;\n            transform: translateX(-5px);\n        }\n        to {\n            opacity: 1;\n            transform: translateX(0);\n        }\n    }\n</style>\n\n<script>\n(function () {\n    function hasText(el, text) {\n        return el && (el.textContent || '').toLowerCase().indexOf(text.toLowerCase()) !== -1;\n    }\n\n    function findSidebar() {\n        var selectors = [\n            'aside',\n            '.sidebar',\n            '#sidebar',\n            '.main-sidebar',\n            '.side-menu',\n            '.app-sidebar',\n            '.navigation',\n            'nav'\n        ];\n\n        for (var i = 0; i < selectors.length; i++) {\n            var list = document.querySelectorAll(selectors[i]);\n\n            for (var j = 0; j < list.length; j++) {\n                var el = list[j];\n                var text = (el.textContent || '').toLowerCase();\n\n                if (\n                    text.indexOf('trang chủ') !== -1 &&\n                    (\n                        text.indexOf('đơn hàng') !== -1 ||\n                        text.indexOf('đề nghị thanh toán') !== -1 ||\n                        text.indexOf('khách hàng') !== -1\n                    )\n                ) {\n                    return el;\n                }\n            }\n        }\n\n        return null;\n    }\n\n    function makeItemByClone(sidebar) {\n        var active = location.pathname.indexOf('/cong-trinh') === 0;\n\n        var candidates = Array.prototype.slice.call(sidebar.querySelectorAll('a')).filter(function (a) {\n            var t = (a.textContent || '').toLowerCase();\n            return t.indexOf('đơn hàng') !== -1 || t.indexOf('đề nghị thanh toán') !== -1 || t.indexOf('khách hàng') !== -1;\n        });\n\n        if (!candidates.length) {\n            return null;\n        }\n\n        var baseLink = candidates[0];\n        var baseWrap = baseLink.closest('li, .nav-item, .menu-item, .sidebar-item, div') || baseLink;\n        var clone = baseWrap.cloneNode(true);\n        var link = clone.querySelector('a') || clone;\n\n        link.href = '/cong-trinh';\n\n        Array.prototype.slice.call(link.childNodes).forEach(function (node) {\n            if (node.nodeType === 3 && node.textContent.trim()) {\n                node.textContent = 'Công trình';\n            }\n        });\n\n        var spans = link.querySelectorAll('span, div, p, strong');\n        var changed = false;\n\n        spans.forEach(function (s) {\n            var t = (s.textContent || '').trim();\n            if (\n                t === 'Đơn hàng' ||\n                t === 'Đề nghị thanh toán' ||\n                t === 'Khách hàng' ||\n                t.indexOf('Đơn hàng') !== -1 ||\n                t.indexOf('Đề nghị thanh toán') !== -1 ||\n                t.indexOf('Khách hàng') !== -1\n            ) {\n                s.textContent = 'Công trình';\n                changed = true;\n            }\n        });\n\n        if (!changed) {\n            link.innerHTML = link.innerHTML.replace(/Đơn hàng|Đề nghị thanh toán|Khách hàng/g, 'Công trình');\n        }\n\n        clone.classList.add('ego-force-site-menu-item');\n\n        if (active) {\n            clone.classList.add('active');\n            link.classList.add('active');\n        } else {\n            clone.classList.remove('active');\n            link.classList.remove('active');\n        }\n\n        clone.querySelectorAll('.badge, .count, [class*="badge"], [class*="count"]').forEach(function (b) {\n            b.remove();\n        });\n\n        return clone;\n    }\n\n    function insertMenu() {\n        var sidebar = findSidebar();\n\n        if (!sidebar) {\n            return;\n        }\n\n        var existing = Array.prototype.slice.call(sidebar.querySelectorAll('a')).some(function (a) {\n            return a.getAttribute('href') && a.getAttribute('href').indexOf('/cong-trinh') !== -1;\n        });\n\n        if (existing) {\n            return;\n        }\n\n        var item = makeItemByClone(sidebar);\n\n        if (!item) {\n            return;\n        }\n\n        var links = Array.prototype.slice.call(sidebar.querySelectorAll('a'));\n        var orderLink = links.find(function (a) {\n            return hasText(a, 'Đơn hàng');\n        });\n\n        var paymentLink = links.find(function (a) {\n            return hasText(a, 'Đề nghị thanh toán');\n        });\n\n        var refWrap = null;\n\n        if (orderLink) {\n            refWrap = orderLink.closest('li, .nav-item, .menu-item, .sidebar-item, div') || orderLink;\n        } else if (paymentLink) {\n            refWrap = paymentLink.closest('li, .nav-item, .menu-item, .sidebar-item, div') || paymentLink;\n        }\n\n        if (refWrap && refWrap.parentNode) {\n            refWrap.parentNode.insertBefore(item, refWrap.nextSibling);\n        } else {\n            sidebar.appendChild(item);\n        }\n    }\n\n    document.addEventListener('DOMContentLoaded', insertMenu);\n    setTimeout(insertMenu, 300);\n    setTimeout(insertMenu, 1000);\n})();\n</script>\n@endif\n{{-- EGO_FORCE_SALES_SITE_MENU_END --}}\n\n\n{{-- EGO_SALES_MANAGER_DROPDOWN_START --}}\n@php\n    $egoSalesManagerOptions = collect();\n\n    try {\n        $egoSalesManagerOptions = \App\Models\User::query()\n            ->get()\n            ->filter(function ($u) {\n                $roles = [];\n\n                foreach (['role', 'type', 'position', 'department'] as $field) {\n                    if (!empty($u->{$field})) {\n                        $roles[] = mb_strtolower((string) $u->{$field});\n                    }\n                }\n\n                if (method_exists($u, 'getRoleNames')) {\n                    foreach ($u->getRoleNames() as $roleName) {\n                        $roles[] = mb_strtolower((string) $roleName);\n                    }\n                }\n\n                $roleText = implode('|', array_unique(array_filter($roles)));\n\n                return str_contains($roleText, 'sales_manager')\n                    || str_contains($roleText, 'sales manager')\n                    || str_contains($roleText, 'trưởng phòng sales')\n                    || str_contains($roleText, 'truong_phong_sales')\n                    || str_contains($roleText, 'manager_sales');\n            })\n            ->map(function ($u) {\n                return [\n                    'id' => (string) $u->id,\n                    'name' => (string) ($u->name ?? $u->email ?? ('User #' . $u->id)),\n                ];\n            })\n            ->values();\n    } catch (\Throwable $e) {\n        $egoSalesManagerOptions = collect();\n    }\n@endphp\n\n<script>\n(function () {\n    var managers = @json($egoSalesManagerOptions);\n\n    function cleanText(value) {\n        return String(value || '').replace(/\s+/g, ' ').trim().toLowerCase();\n    }\n\n    function selectLooksLikeSalesOwner(select) {\n        var name = cleanText(select.getAttribute('name'));\n        var id = cleanText(select.getAttribute('id'));\n        var text = cleanText(select.closest('form, .modal, .card, section, div') ? select.closest('form, .modal, .card, section, div').textContent : '');\n\n        return name.indexOf('sales') !== -1\n            || name.indexOf('assigned') !== -1\n            || name.indexOf('owner') !== -1\n            || id.indexOf('sales') !== -1\n            || text.indexOf('sales phụ trách') !== -1\n            || text.indexOf('sales phu trach') !== -1;\n    }\n\n    function hasOption(select, value) {\n        return Array.prototype.slice.call(select.options).some(function (opt) {\n            return String(opt.value) === String(value);\n        });\n    }\n\n    function addManagersToSelect(select) {\n        if (!select || !selectLooksLikeSalesOwner(select)) return;\n\n        managers.forEach(function (manager) {\n            if (!manager || !manager.id || hasOption(select, manager.id)) return;\n\n            var option = document.createElement('option');\n            option.value = manager.id;\n            option.textContent = manager.name + ' - Sales Manager';\n            option.setAttribute('data-ego-sales-manager', '1');\n\n            select.appendChild(option);\n        });\n    }\n\n    function run() {\n        if (!Array.isArray(managers) || managers.length === 0) return;\n\n        document.querySelectorAll('select').forEach(addManagersToSelect);\n    }\n\n    document.addEventListener('DOMContentLoaded', run);\n\n    setTimeout(run, 300);\n    setTimeout(run, 900);\n    setTimeout(run, 1800);\n\n    document.addEventListener('click', function () {\n        setTimeout(run, 150);\n        setTimeout(run, 500);\n    }, true);\n})();\n</script>\n{{-- EGO_SALES_MANAGER_DROPDOWN_END --}}\n\n{{-- EGO_DON_VAT_TU_CLICK_GUARD_START --}}\n<script>\n(function () {\n    var DON_VAT_TU_URL = '/don-vat-tu';\n\n    function norm(value) {\n        return String(value || '')\n            .normalize('NFD')\n            .replace(/[\u0300-\u036f]/g, '')\n            .replace(/đ/g, 'd')\n            .replace(/Đ/g, 'D')\n            .replace(/\s+/g, ' ')\n            .trim()\n            .toLowerCase();\n    }\n\n    function isDonVatTuAnchor(a) {\n        if (!a) return false;\n\n        var href = a.getAttribute('href') || '';\n        var text = norm(a.textContent || '');\n\n        return href.indexOf('/don-vat-tu') !== -1 || text.indexOf('don vat tu') !== -1;\n    }\n\n    function fixDonVatTuLinks() {\n        document.querySelectorAll('#sidebar a, #egoFlyout a').forEach(function (a) {\n            if (!isDonVatTuAnchor(a)) return;\n\n            a.setAttribute('href', DON_VAT_TU_URL);\n            a.setAttribute('data-ego-type', 'nav');\n\n            [\n                'data-bs-toggle',\n                'data-toggle',\n                'data-bs-target',\n                'data-target',\n                'aria-controls'\n            ].forEach(function (attr) {\n                a.removeAttribute(attr);\n            });\n\n            var node = a;\n            while (node && node !== document) {\n                if (node.removeAttribute) {\n                    node.removeAttribute('data-ego-cong-trinh-click');\n                }\n\n                if (node.id === 'sidebar' || node.id === 'egoFlyout') break;\n\n                node = node.parentNode;\n            }\n        });\n    }\n\n    window.addEventListener('click', function (event) {\n        var target = event.target;\n        var a = target && target.closest ? target.closest('a') : null;\n\n        if (!a) return;\n        if (!a.closest('#sidebar') && !a.closest('#egoFlyout')) return;\n        if (!isDonVatTuAnchor(a)) return;\n\n        event.preventDefault();\n        event.stopPropagation();\n        event.stopImmediatePropagation();\n\n        window.location.href = DON_VAT_TU_URL;\n    }, true);\n\n    document.addEventListener('DOMContentLoaded', fixDonVatTuLinks);\n    fixDonVatTuLinks();\n\n    setTimeout(fixDonVatTuLinks, 100);\n    setTimeout(fixDonVatTuLinks, 500);\n    setTimeout(fixDonVatTuLinks, 1200);\n})();\n</script>\n{{-- EGO_DON_VAT_TU_CLICK_GUARD_END --}}\n@includeIf('payment-requests._buibichthao_actions')\n\n