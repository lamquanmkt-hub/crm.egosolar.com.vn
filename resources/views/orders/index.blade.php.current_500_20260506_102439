        @php
            /*
            |--------------------------------------------------------------------------
            | Tổng thu / công nợ
            |--------------------------------------------------------------------------
            | Tính trực tiếp từ danh sách đang hiển thị để chắc chắn có số ngay.
            | Nếu Controller có truyền $orderSummary thì ưu tiên dùng $orderSummary.
            */

            $orderRows = collect($orders->items());

            $viewSummaryTotalAmount = $orderRows->sum(function ($order) {
                return (float) ($order->total_amount ?? 0);
            });

            $viewSummaryTotalPaid = $orderRows->sum(function ($order) {
                return (float) collect($order->payments ?? [])->sum('amount');
            });

            $viewSummaryTotalDebt = $orderRows->sum(function ($order) {
                $total = (float) ($order->total_amount ?? 0);
                $paid  = (float) collect($order->payments ?? [])->sum('amount');

                return max($total - $paid, 0);
            });

            $viewSummaryDebtOver30 = $orderRows->sum(function ($order) {
                $total = (float) ($order->total_amount ?? 0);
                $paid  = (float) collect($order->payments ?? [])->sum('amount');
                $debt  = max($total - $paid, 0);

                if ($debt <= 0 || empty($order->order_date)) {
                    return 0;
                }

                try {
                    return \Illuminate\Support\Carbon::parse($order->order_date)->lte(now()->subDays(30))
                        ? $debt
                        : 0;
                } catch (\Throwable $e) {
                    return 0;
                }
            });

            $summaryTotalAmount = (float) ($orderSummary['total_amount'] ?? $viewSummaryTotalAmount);
            $summaryTotalPaid   = (float) ($orderSummary['total_paid'] ?? $viewSummaryTotalPaid);
            $summaryTotalDebt   = (float) ($orderSummary['total_debt'] ?? $viewSummaryTotalDebt);
            $summaryDebtOver30  = (float) ($orderSummary['debt_over_30'] ?? $viewSummaryDebtOver30);

            $hasFilter = request()->hasAny([
                'search',
                'status',
                'company_id',
                'created_by',
                'payment_filter',
                'from_date',
                'to_date',
            ]);
