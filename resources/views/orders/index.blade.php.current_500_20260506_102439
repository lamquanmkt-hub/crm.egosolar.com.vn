<script>
    function setShipOrderId(button) {
        const orderId = button.getAttribute('data-order-id');
        const form = document.getElementById('shipForm');

        form.action = `/orders/${orderId}/ship`;

        const dateEl = document.getElementById('actual_ship_date');

        if (dateEl) {
            dateEl.valueAsDate = new Date();
        }
    }

    function setDeleteOrderData(button) {
        const orderId = button.getAttribute('data-order-id');
        const orderCode = button.getAttribute('data-order-code');

        document.getElementById('deleteForm').action = `/orders/${orderId}`;
        document.getElementById('deleteOrderCodeDisplay').textContent = orderCode;
    }
</script>
