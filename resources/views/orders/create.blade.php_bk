    <script>
        let rowIndex = 1;
        let customerTypeId = null;

        // Khi chọn khách hàng
        document.getElementById('customerSelect').addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const customerId = this.value;
            const leadId = selectedOption.dataset.leadId;

            document.getElementById('leadIdInput').value = leadId;

            if (customerId) {
                fetchCustomerInfo(customerId);
            } else {
                document.getElementById('customerInfo').style.display = 'none';
            }
        });

        // Lấy thông tin khách hàng
        async function fetchCustomerInfo(customerId) {
            try {
                const response = await fetch(`/orders/customer-info/${customerId}`);
                const data = await response.json();

                customerTypeId = data.customer.customer_type_id;

                document.getElementById('customerType').textContent = data.customer.customer_type?.name || 'N/A';
                document.getElementById('customerRegion').textContent = data.customer.region?.name || 'N/A';
                document.getElementById('customerOrders').textContent = data.latest_orders.length;
                document.getElementById('customerDebt').textContent = new Intl.NumberFormat('vi-VN').format(data.total_debt) + ' đ';

                document.getElementById('customerInfo').style.display = 'block';

                // Cập nhật giá sản phẩm theo loại khách
                updateAllProductPrices();
            } catch (error) {
                console.error('Error fetching customer info:', error);
            }
        }

        // Thêm dòng sản phẩm
        function addProductRow() {
            const tbody = document.getElementById('productTableBody');
            const newRow = tbody.querySelector('.product-row').cloneNode(true);

            // Reset values
            newRow.querySelectorAll('input, select').forEach(input => {
                if (input.classList.contains('quantity')) {
                    input.value = 1;
                } else {
                    input.value = '';
                }
            });

            // Update names
            newRow.querySelectorAll('[name]').forEach(input => {
                input.name = input.name.replace(/\[\d+\]/, `[${rowIndex}]`);
            });

            tbody.appendChild(newRow);
            attachProductEvents(newRow);
            rowIndex++;
        }

        // Xóa dòng sản phẩm
        function removeProductRow(btn) {
            const tbody = document.getElementById('productTableBody');
            if (tbody.querySelectorAll('.product-row').length > 1) {
                btn.closest('.product-row').remove();
                calculateTotal();
            }
        }

        // Gắn sự kiện cho sản phẩm
        function attachProductEvents(row) {
            const productSelect = row.querySelector('.product-select');
            const quantityInput = row.querySelector('.quantity');

            productSelect.addEventListener('change', function() {
                updateProductPrice(row);
            });

            quantityInput.addEventListener('input', function() {
                calculateLineTotal(row);
            });
        }

        // Cập nhật giá sản phẩm
        function updateProductPrice(row) {
            const productSelect = row.querySelector('.product-select');
            const priceInput = row.querySelector('.unit-price');
            const selectedOption = productSelect.options[productSelect.selectedIndex];

            let price = 0;

            if (selectedOption.value) {
                // Chọn giá theo loại khách
                if (customerTypeId == 1) { // Giả sử 1 = Đại lý
                    price = parseFloat(selectedOption.dataset.priceAgent) || 0;
                } else if (customerTypeId == 2) { // 2 = Lẻ
                    price = parseFloat(selectedOption.dataset.priceRetail) || 0;
                } else {
                    price = parseFloat(selectedOption.dataset.price) || 0;
                }
            }

            priceInput.value = price;
            calculateLineTotal(row);
        }

        // Tính thành tiền
        function calculateLineTotal(row) {
            const price = parseFloat(row.querySelector('.unit-price').value) || 0;
            const quantity = parseInt(row.querySelector('.quantity').value) || 0;
            const lineTotal = price * quantity;

            row.querySelector('.line-total').value = new Intl.NumberFormat('vi-VN').format(lineTotal) + ' đ';

            calculateTotal();
        }

        // Tính tổng
        function calculateTotal() {
            const rows = document.querySelectorAll('.product-row');
            let totalItems = 0;
            let totalQuantity = 0;
            let grandTotal = 0;

            rows.forEach(row => {
                const productSelect = row.querySelector('.product-select');
                if (productSelect.value) {
                    totalItems++;
                    const quantity = parseInt(row.querySelector('.quantity').value) || 0;
                    const price = parseFloat(row.querySelector('.unit-price').value) || 0;

                    totalQuantity += quantity;
                    grandTotal += price * quantity;
                }
            });

            document.getElementById('totalItems').textContent = totalItems;
            document.getElementById('totalQuantity').textContent = totalQuantity;
            document.getElementById('totalAmount').textContent = new Intl.NumberFormat('vi-VN').format(grandTotal) + ' đ';
            document.getElementById('grandTotal').textContent = new Intl.NumberFormat('vi-VN').format(grandTotal) + ' đ';
        }

        // Cập nhật giá tất cả sản phẩm khi đổi khách
        function updateAllProductPrices() {
            document.querySelectorAll('.product-row').forEach(row => {
                const select = row.querySelector('.product-select');
                if (select.value) {
                    updateProductPrice(row);
                }
            });
        }

        // Khởi tạo
        document.querySelectorAll('.product-row').forEach(row => {
            attachProductEvents(row);
        });
    </script>
@endsection