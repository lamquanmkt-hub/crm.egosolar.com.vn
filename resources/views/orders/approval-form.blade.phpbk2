    <script>
        function toggleRejectionReason() {
            const rejectRadio = document.getElementById('actionReject');
            const rejectionGroup = document.getElementById('rejectionReasonGroup');
            const rejectionInput = document.getElementById('rejectionReason');
            const submitBtn = document.getElementById('submitBtn');

            if (rejectRadio.checked) {
                rejectionGroup.style.display = 'block';
                rejectionInput.required = true;
                submitBtn.innerHTML = '<i class="bi bi-x-circle"></i> Xác nhận từ chối';
                submitBtn.className = 'btn btn-danger btn-lg';
            } else {
                rejectionGroup.style.display = 'none';
                rejectionInput.required = false;
                submitBtn.innerHTML = '<i class="bi bi-check-circle"></i> Xác nhận duyệt';
                submitBtn.className = 'btn btn-success btn-lg';
            }
        }

        // Gọi function khi load trang để hiển thị đúng state nếu có old input
        document.addEventListener('DOMContentLoaded', function() {
            const actionReject = document.getElementById('actionReject');
            if (actionReject && actionReject.checked) {
                toggleRejectionReason();
            }
        });

        // Xác nhận trước khi submit
        document.getElementById('approvalForm').addEventListener('submit', function (e) {
            const action = document.querySelector('input[name="action"]:checked');

            if (!action) {
                e.preventDefault();
                alert('Vui lòng chọn hành động (Duyệt hoặc Từ chối)');
                return false;
            }

            const actionText = action.value === 'approve' ? 'DUYỆT' : 'TỪ CHỐI';
            const confirmMsg = `Bạn có chắc chắn muốn ${actionText} đơn hàng này?`;

            if (!confirm(confirmMsg)) {
                e.preventDefault();
                return false;
            }
        });
    </script>
    <script>
        // Debug form submission
        document.getElementById('approvalForm').addEventListener('submit', function (e) {
            console.log('========================================');
            console.log('🔵 FORM SUBMIT DEBUG');
            console.log('========================================');

            const action = document.querySelector('input[name="action"]:checked');
            const debtCheckbox = document.getElementById('debtChecked');
            const rejectionReason = document.getElementById('rejectionReason');
            const note = document.querySelector('textarea[name="note"]');
            const debtNote = document.querySelector('textarea[name="debt_note"]');

            // Log tất cả field values
            console.log('Form Fields:');
            console.log('- action:', action ? action.value : 'NOT SELECTED');
            console.log('- debt_checked (checkbox):', debtCheckbox ? debtCheckbox.checked : 'N/A');
            console.log('- debt_checked (value):', debtCheckbox ? debtCheckbox.value : 'N/A');
            console.log('- rejection_reason:', rejectionReason ? rejectionReason.value : 'N/A');
            console.log('- note:', note ? note.value : '');
            console.log('- debt_note:', debtNote ? debtNote.value : 'N/A');

            // Kiểm tra validation
            if (!action) {
                e.preventDefault();
                alert('⚠️ DEBUG: Chưa chọn hành động (Duyệt/Từ chối)');
                console.error('❌ Action not selected');
                return false;
            }

            // Nếu là ketoan và approve, check debt_checked
            @if($currentLevel === 'ketoan')
            if (action.value === 'approve') {
                console.log('🔵 Checking debt_checked for ketoan...');

                if (!debtCheckbox.checked) {
                    e.preventDefault();
                    alert('⚠️ DEBUG: Bạn chưa tích checkbox xác nhận kiểm tra công nợ!');
                    console.error('❌ debt_checked not checked');

                    // Highlight checkbox
                    debtCheckbox.style.border = '2px solid red';
                    debtCheckbox.scrollIntoView({ behavior: 'smooth', block: 'center' });

                    return false;
                } else {
                    console.log('✅ debt_checked is CHECKED');
                }
            }
            @endif

            // Nếu từ chối, check lý do
            if (action.value === 'reject' && !rejectionReason.value.trim()) {
                e.preventDefault();
                alert('⚠️ DEBUG: Chưa nhập lý do từ chối!');
                console.error('❌ Rejection reason is empty');
                return false;
            }

            // Confirm
            const actionText = action.value === 'approve' ? 'DUYỆT' : 'TỪ CHỐI';
            const confirmMsg = `Bạn có chắc chắn muốn ${actionText} đơn hàng này?`;

            console.log('🔵 Showing confirm dialog:', confirmMsg);

            if (!confirm(confirmMsg)) {
                e.preventDefault();
                console.log('❌ User cancelled');
                return false;
            }

            console.log('✅ All checks passed, submitting form...');
            console.log('========================================');

            // Let form submit normally
            return true;
        });

        // Real-time debug khi thay đổi checkbox
        @if($currentLevel === 'ketoan')
        const debtCheckbox = document.getElementById('debtChecked');
        if (debtCheckbox) {
            debtCheckbox.addEventListener('change', function() {
                console.log('🔵 Checkbox changed:', {
                    'checked': this.checked,
                    'value': this.value
                });
            });
        }
        @endif
    </script>
