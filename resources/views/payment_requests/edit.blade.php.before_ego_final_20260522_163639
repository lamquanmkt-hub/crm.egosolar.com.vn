<script>
(function () {
    var paymentRequestId = @json($egoThaoPrId);
    var csrf = @json(csrf_token());
    var attachments = @json($egoThaoPrAttachments);

    var uploadUrl = '/payment-requests/' + paymentRequestId + '/attachments-thao';

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function sizeText(size) {
        size = Number(size || 0);

        if (!size) {
            return '';
        }

        if (size < 1024) {
            return size + ' B';
        }

        if (size < 1024 * 1024) {
            return (size / 1024).toFixed(1) + ' KB';
        }

        return (size / 1024 / 1024).toFixed(1) + ' MB';
    }

    function apiPost(url, formData) {
        return fetch(url, {
            method: 'POST',
            headers: {
                'X-CSRF-TOKEN': csrf,
                'Accept': 'application/json'
            },
            body: formData,
            credentials: 'same-origin'
        }).then(function (res) {
            return res.json().catch(function () {
                return {};
            }).then(function (data) {
                if (!res.ok || data.ok === false) {
                    throw new Error(data.message || 'Không xử lý được chứng từ.');
                }

                return data;
            });
        });
    }

    function buildList() {
        if (!attachments.length) {
            return '<div class="ego-thao-pr-empty">Phiếu này chưa có chứng từ đính kèm.</div>';
        }

        return '<div class="ego-thao-pr-file-list">' + attachments.map(function (a) {
            var meta = [sizeText(a.size), a.mime].filter(Boolean).join(' · ');

            return '' +
                '<div class="ego-thao-pr-file-row" data-attachment-id="' + a.id + '">' +
                    '<div>' +
                        '<a class="ego-thao-pr-file-name" href="' + escapeHtml(a.download_url) + '" target="_blank">' + escapeHtml(a.name) + '</a>' +
                        '<div class="ego-thao-pr-file-meta">' + escapeHtml(meta || 'Chứng từ') + '</div>' +
                    '</div>' +
                    '<input type="file" data-ego-replace-file="' + a.id + '">' +
                    '<button type="button" class="ego-thao-pr-btn ego-thao-pr-btn-update" data-ego-replace="' + a.id + '">Cập nhật</button>' +
                    '<button type="button" class="ego-thao-pr-btn ego-thao-pr-btn-delete" data-ego-delete="' + a.id + '">Xóa</button>' +
                '</div>';
        }).join('') + '</div>';
    }

    function buildUi() {
        return '' +
            '<div class="ego-thao-pr-attachments" id="egoThaoPrAttachmentsBox">' +
                '<h3>Chứng từ hiện có</h3>' +
                '<p>buibichthao@egosolar.vn được thêm, xóa và cập nhật chứng từ ĐNTT ở mọi trạng thái.</p>' +
                '<div class="ego-thao-pr-upload">' +
                    '<input type="file" id="egoThaoPrNewAttachments" multiple>' +
                    '<button type="button" class="ego-thao-pr-btn ego-thao-pr-btn-add" id="egoThaoPrUploadBtn">Thêm chứng từ</button>' +
                '</div>' +
                buildList() +
            '</div>';
    }

    function findAttachmentSection() {
        var candidates = Array.prototype.slice.call(document.querySelectorAll('div, section, fieldset'))
            .filter(function (el) {
                var text = (el.innerText || '').toLowerCase();

                return text.indexOf('chứng từ hiện có') !== -1
                    && (
                        text.indexOf('phiếu này') !== -1 ||
                        text.indexOf('chứng từ cũ') !== -1 ||
                        text.indexOf('form sửa') !== -1
                    );
            })
            .filter(function (el) {
                var rect = el.getBoundingClientRect();
                return rect.width > 260 && rect.height < 520;
            })
            .sort(function (a, b) {
                return a.getBoundingClientRect().height - b.getBoundingClientRect().height;
            });

        if (candidates.length) {
            return candidates[0];
        }

        return null;
    }

    function mount() {
        if (document.getElementById('egoThaoPrAttachmentsBox')) {
            return;
        }

        var target = findAttachmentSection();

        if (target) {
            target.innerHTML = buildUi();
            return;
        }

        var form = document.querySelector('form');

        if (form) {
            var wrapper = document.createElement('div');
            wrapper.innerHTML = buildUi();
            form.appendChild(wrapper);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        mount();
        setTimeout(mount, 150);
        setTimeout(mount, 500);
    });

    document.addEventListener('click', function (event) {
        var uploadBtn = event.target.closest('#egoThaoPrUploadBtn');

        if (uploadBtn) {
            var input = document.getElementById('egoThaoPrNewAttachments');

            if (!input || !input.files || !input.files.length) {
                alert('Vui lòng chọn chứng từ cần thêm.');
                return;
            }

            var fd = new FormData();

            Array.prototype.slice.call(input.files).forEach(function (file) {
                fd.append('attachments[]', file);
            });

            apiPost(uploadUrl, fd)
                .then(function () {
                    location.reload();
                })
                .catch(function (err) {
                    alert(err.message);
                });

            return;
        }

        var replaceBtn = event.target.closest('[data-ego-replace]');

        if (replaceBtn) {
            var id = replaceBtn.getAttribute('data-ego-replace');
            var inputReplace = document.querySelector('[data-ego-replace-file="' + id + '"]');

            if (!inputReplace || !inputReplace.files || !inputReplace.files.length) {
                alert('Vui lòng chọn file mới để cập nhật chứng từ.');
                return;
            }

            var fdReplace = new FormData();
            fdReplace.append('_method', 'PUT');
            fdReplace.append('attachment', inputReplace.files[0]);

            apiPost('/payment-requests/' + paymentRequestId + '/attachments-thao/' + id + '/cap-nhat', fdReplace)
                .then(function () {
                    location.reload();
                })
                .catch(function (err) {
                    alert(err.message);
                });

            return;
        }

        var deleteBtn = event.target.closest('[data-ego-delete]');

        if (deleteBtn) {
            var deleteId = deleteBtn.getAttribute('data-ego-delete');

            if (!confirm('Xóa chứng từ này?')) {
                return;
            }

            var fdDelete = new FormData();
            fdDelete.append('_method', 'DELETE');

            apiPost('/payment-requests/' + paymentRequestId + '/attachments-thao/' + deleteId + '/xoa', fdDelete)
                .then(function () {
                    location.reload();
                })
                .catch(function (err) {
                    alert(err.message);
                });
        }
    });
})();
</script>
