<style>
    .summary-icon{
        width: 36px;height:36px;border-radius:12px;
        display:flex;align-items:center;justify-content:center;
        background: rgba(13,110,253,.10); color:#0d6efd;
    }
</style>

<script>
(function(){
    // ====== SITE INFO ======
    const siteSelect = document.getElementById('siteSelect');
    const siteInfo   = document.getElementById('siteInfo');
    const siName     = document.getElementById('siName');
    const siAddress  = document.getElementById('siAddress');
    const siContact  = document.getElementById('siContact');
    const siPhone    = document.getElementById('siPhone');

    const sumSite = document.getElementById('sumSite');

    function updateSiteInfo(){
        const opt = siteSelect?.selectedOptions?.[0];
        if(!opt || !siteSelect.value){
            siteInfo.style.display = 'none';
            sumSite.textContent = '—';
            return;
        }
        siteInfo.style.display = 'block';
        siName.textContent    = opt.dataset.name || '—';
        siAddress.textContent = opt.dataset.address || '—';
        siContact.textContent = opt.dataset.contact || '—';
        siPhone.textContent   = opt.dataset.phone || '—';

        sumSite.textContent = opt.dataset.name || opt.textContent.trim();
    }

    siteSelect?.addEventListener('change', () => {
        updateSiteInfo();
        updateSummary();
    });
    updateSiteInfo();

    // ====== STOCK ROWS (warehouse + product filter) ======
    const stockBody = document.getElementById('stockBody');
    const addStockRowBtn = document.getElementById('addStockRowBtn');

    function filterProductsByWarehouse(row){
    const wSel = row.querySelector('.warehouse-select');
    const pSel = row.querySelector('.product-select');
    const hint = row.querySelector('.stock-empty-hint');

    const wid = String(wSel.value || '').trim();

    // reset product
    pSel.value = '';
    pSel.disabled = !wid;

    let visibleCount = 0;

    [...pSel.options].forEach((opt, idx) => {
        if(idx === 0) return; // placeholder luôn hiện

        const optWid = String(opt.dataset.warehouse || '').trim();

        // match đúng kho thì hiện
        const isMatch = (optWid === wid);

        opt.hidden = !isMatch;
        if(isMatch) visibleCount++;
    });

    // ✅ Nếu không có gì match => hiện cảnh báo (và giữ dropdown chỉ có placeholder)
    if(hint){
        hint.classList.toggle('d-none', !(wid && visibleCount === 0));
    }

    updateSummary();
}

    function bindStockRow(row){
        const wSel = row.querySelector('.warehouse-select');
        const pSel = row.querySelector('.product-select');

        wSel.addEventListener('change', () => filterProductsByWarehouse(row));
        pSel.addEventListener('change', updateSummary);
        row.querySelector('.qty-input')?.addEventListener('input', updateSummary);
        row.querySelector('.row-note')?.addEventListener('input', updateSummary);

        row.querySelector('.remove-row')?.addEventListener('click', () => {
            const rows = stockBody.querySelectorAll('.stock-row');
            if(rows.length <= 1) return;
            row.remove();
            renumber(stockBody, '.stock-row');
            updateSummary();
        });
    }

    function addStockRow(){
        const first = stockBody.querySelector('.stock-row');
        const clone = first.cloneNode(true);

        clone.querySelectorAll('input').forEach(i => i.value = '');
        clone.querySelectorAll('select').forEach(s => s.value = '');

        // disable product until warehouse chosen
        clone.querySelector('.product-select').disabled = true;
        [...clone.querySelector('.product-select').options].forEach((opt, idx) => {
            if(idx === 0) return;
            opt.hidden = true;
        });

        stockBody.appendChild(clone);
        bindStockRow(clone);
        renumber(stockBody, '.stock-row');
        updateSummary();
    }

    bindStockRow(stockBody.querySelector('.stock-row'));
    addStockRowBtn?.addEventListener('click', addStockRow);

    // init: hide all product options for first row
    (function initFirstRow(){
        const row = stockBody.querySelector('.stock-row');
        const pSel = row.querySelector('.product-select');
        pSel.disabled = true;
        [...pSel.options].forEach((opt, idx) => { if(idx!==0) opt.hidden = true; });
    })();

    // ====== EXTRA ROWS ======
    const extraBody = document.getElementById('extraBody');
    const addExtraRowBtn = document.getElementById('addExtraRowBtn');

    function bindExtraRow(row){
        row.querySelector('.extra-name')?.addEventListener('input', updateSummary);
        row.querySelector('.extra-qty')?.addEventListener('input', updateSummary);
        row.querySelector('.extra-note')?.addEventListener('input', updateSummary);

        row.querySelector('.remove-extra')?.addEventListener('click', () => {
            const rows = extraBody.querySelectorAll('.extra-row');
            if(rows.length <= 1) return;
            row.remove();
            renumber(extraBody, '.extra-row');
            updateSummary();
        });
    }

    function addExtraRow(){
        const first = extraBody.querySelector('.extra-row');
        const clone = first.cloneNode(true);
        clone.querySelectorAll('input').forEach(i => i.value = '');
        extraBody.appendChild(clone);
        bindExtraRow(clone);
        renumber(extraBody, '.extra-row');
        updateSummary();
    }

    bindExtraRow(extraBody.querySelector('.extra-row'));
    addExtraRowBtn?.addEventListener('click', addExtraRow);

    // ====== SUMMARY ======
    const sumStockLines = document.getElementById('sumStockLines');
    const sumExtraLines = document.getElementById('sumExtraLines');
    const sumStockList  = document.getElementById('sumStockList');
    const sumExtraList  = document.getElementById('sumExtraList');

    function escapeHtml(str){
        return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
    }

    function updateSummary(){
        // STOCK
        const stockRows = stockBody.querySelectorAll('.stock-row');
        const stockItems = [];
        stockRows.forEach(row => {
            const wSel = row.querySelector('.warehouse-select');
            const pSel = row.querySelector('.product-select');
            const qty  = row.querySelector('.qty-input');
            const note = row.querySelector('.row-note');

            const wid  = wSel.value;
            const wTxt = wSel.selectedOptions?.[0]?.textContent?.trim() || '';
            const pid  = pSel.value;
            const pTxt = pid ? pSel.selectedOptions[0].textContent.trim() : '';
            const q    = parseFloat(qty.value || 0);

            if(wid && pid && q > 0){
                stockItems.push({
                    warehouse: wTxt,
                    product: pTxt,
                    qty: q,
                    note: (note.value||'').trim()
                });
            }
        });

        sumStockLines.textContent = stockItems.length;
        sumStockList.innerHTML = '';
        if(stockItems.length === 0){
            sumStockList.innerHTML = `<div class="text-muted small">Chưa có</div>`;
        }else{
            stockItems.forEach(it => {
                const div = document.createElement('div');
                div.className = 'p-2 rounded-3 border bg-white';
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div style="font-size:13px;">
                            <div class="fw-semibold">${escapeHtml(it.product)}</div>
                            <div class="text-muted small">${escapeHtml(it.warehouse)}</div>
                        </div>
                        <div class="badge bg-primary rounded-pill">${it.qty}</div>
                    </div>
                    ${it.note ? `<div class="text-muted small mt-1">${escapeHtml(it.note)}</div>` : ''}
                `;
                sumStockList.appendChild(div);
            });
        }

        // EXTRA
        const extraRows = extraBody.querySelectorAll('.extra-row');
        const extraItems = [];
        extraRows.forEach(row => {
            const name = (row.querySelector('.extra-name')?.value || '').trim();
            const qty  = parseFloat(row.querySelector('.extra-qty')?.value || 0);
            const note = (row.querySelector('.extra-note')?.value || '').trim();
            if(name && qty > 0){
                extraItems.push({name, qty, note});
            }
        });

        sumExtraLines.textContent = extraItems.length;
        sumExtraList.innerHTML = '';
        if(extraItems.length === 0){
            sumExtraList.innerHTML = `<div class="text-muted small">Chưa có</div>`;
        }else{
            extraItems.forEach(it => {
                const div = document.createElement('div');
                div.className = 'p-2 rounded-3 border bg-white';
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="fw-semibold" style="font-size:13px;">${escapeHtml(it.name)}</div>
                        <div class="badge bg-secondary rounded-pill">${it.qty}</div>
                    </div>
                    ${it.note ? `<div class="text-muted small mt-1">${escapeHtml(it.note)}</div>` : ''}
                `;
                sumExtraList.appendChild(div);
            });
        }
    }

    function renumber(tbody, rowSelector){
        const rows = tbody.querySelectorAll(rowSelector);
        rows.forEach((row, idx) => row.querySelector('.row-no').textContent = idx + 1);

        // reindex names: stock[idx] / extra[idx]
        rows.forEach((row, idx) => {
            row.querySelectorAll('input, select').forEach(el => {
                const name = el.getAttribute('name');
                if(!name) return;
                if(name.startsWith('stock[')){
                    el.setAttribute('name', name.replace(/stock\[\d+\]/, `stock[${idx}]`));
                }
                if(name.startsWith('extra[')){
                    el.setAttribute('name', name.replace(/extra\[\d+\]/, `extra[${idx}]`));
                }
            });
        });
    }

    updateSummary();
})();
</script>
@endsection
